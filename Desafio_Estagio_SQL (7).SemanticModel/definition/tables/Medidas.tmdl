			        PiorVendedorMargem,
			        CALCULATE([Margem de Lucro %])
			    )
			
			/* =========================
			   MELHOR MÊS
			   ========================= */
			
			VAR MesesReceita =
			    ADDCOLUMNS(
			        ALLSELECTED(DimData[Mes]),
			        "@ReceitaMes",
			        CALCULATE([Receita Total])
			    )
			
			VAR MelhorMes =
			    TOPN(
			        1,
			        MesesReceita,
			        [@ReceitaMes],
			        DESC
			    )
			
			VAR NomeMelhorMes =
			    CONCATENATEX(
			        MelhorMes,
			        DimData[Mes],
			        ""
			    )
			
			VAR ReceitaMelhorMes =
			    MAXX(
			        MelhorMes,
			        [@ReceitaMes]
			    )
			
			/* =========================
			   PIOR MÊS
			   ========================= */
			
			VAR PiorMes =
			    TOPN(
			        1,
			        MesesReceita,
			        [@ReceitaMes],
			        ASC
			    )
			
			VAR NomePiorMes =
			    CONCATENATEX(
			        PiorMes,
			        DimData[Mes],
			        ""
			    )
			
			VAR ReceitaPiorMes =
			    MINX(
			        PiorMes,
			        [@ReceitaMes]
			    )
			
			RETURN
			
			"<div style='width:100%;height:100%;padding:22px 24px;background:#FFFFFF;font-family:Segoe UI,Arial,sans-serif;color:#0F172A;overflow-y:auto;'>
			
			<div style='font-size:18px;font-weight:600;color:#0F172A;'>
			Possíveis Soluções
			</div>
			
			<div style='margin-top:5px;font-size:12px;line-height:1.5;color:#64748B;'>
			Ações que podem ser avaliadas a partir dos comportamentos identificados na performance individual dos vendedores.
			</div>
			
			<div style='margin-top:70px;'>
			
			<div class='item'>
			<div class='text'>
			<div class='item-title'>Replicar práticas do vendedor líder</div>
			<div class='desc'>
			<strong>" &
			NomeTopVendedorReceita &
			"</strong> lidera o faturamento com <strong>" &
			FORMAT(ReceitaTopVendedor,"R$ #,##0.00","pt-BR") &
			"</strong>. Vale analisar carteira, mix de produtos, volume e abordagem comercial para identificar práticas que possam ser compartilhadas com a equipe.
			</div>
			</div>
			<span class='badge purple'>Performance</span>
			</div>
			
			<div class='item'>
			<div class='text'>
			<div class='item-title'>Investigar a baixa performance individual</div>
			<div class='desc'>
			<strong>" &
			NomePiorVendedorReceita &
			"</strong> apresenta a menor receita. Uma análise de carteira, quantidade de vendas, ticket médio e oportunidades perdidas pode ajudar a identificar a origem da diferença.
			</div>
			</div>
			<span class='badge purple'>Equipe</span>
			</div>
			
			<div class='item'>
			<div class='text'>
			<div class='item-title'>Revisar fatores que reduzem a margem</div>
			<div class='desc'>
			<strong>" &
			NomePiorVendedorMargem &
			"</strong> apresenta margem de <strong>" &
			FORMAT(MargemPiorVendedor,"0.0%","pt-BR") &
			"</strong>. Vale revisar descontos, preços praticados, mix vendido e condições comerciais antes de buscar aumento de volume.
			</div>
			</div>
			<span class='badge purple'>Margem</span>
			</div>
			
			<div class='item'>
			<div class='text'>
			<div class='item-title'>Reproduzir estratégias do melhor mês</div>
			<div class='desc'>
			<strong>" &
			NomeMelhorMes &
			"</strong> apresentou o maior faturamento, de <strong>" &
			FORMAT(ReceitaMelhorMes,"R$ #,##0.00","pt-BR") &
			"</strong>. Investigar campanhas, produtos, volume e condições comerciais desse período pode revelar estratégias replicáveis.
			</div>
			</div>
			<span class='badge blue'>Sazonalidade</span>
			</div>
			
			<div class='item'>
			<div class='text'>
			<div class='item-title'>Criar plano para períodos de baixa</div>
			<div class='desc'>
			<strong>" &
			NomePiorMes &
			"</strong> registrou o menor faturamento, de <strong>" &
			FORMAT(ReceitaPiorMes,"R$ #,##0.00","pt-BR") &
			"</strong>. Antecipar campanhas, acompanhamento comercial e ações sobre produtos estratégicos pode ajudar a reduzir oscilações.
			</div>
			</div>
			<span class='badge purple'>Planejamento</span>
			</div>
			
			<div class='item'>
			<div class='text'>
			<div class='item-title'>Acompanhar crescimento sem comprometer a margem</div>
			<div class='desc'>
			A expansão das vendas deve ser acompanhada pela rentabilidade. O objetivo é aumentar o volume comercial mantendo uma margem saudável de <strong>" &
			FORMAT(MargemAtual,"0.0%","pt-BR") &
			"</strong>.
			</div>
			</div>
			<span class='badge blue'>Performance</span>
			</div>
			
			</div>
			
			<style>
			
