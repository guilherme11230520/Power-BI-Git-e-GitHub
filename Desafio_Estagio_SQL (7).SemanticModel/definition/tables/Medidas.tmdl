			</style>
			
			</div>"
		displayFolder: HTML Insights
		lineageTag: 31a5311a-6abe-479f-968f-25e802cbb8da

	measure 'Insight Receita Mensal' =
			
			
			VAR TabelaMeses =
			    ADDCOLUMNS(
			        ALLSELECTED(DimData[NomeMes]),
			        "@Receita", CALCULATE([Receita Total])
			    )
			
			VAR MaiorMes =
			    TOPN(1, TabelaMeses, [@Receita], DESC)
			
			VAR MenorMes =
			    TOPN(1, TabelaMeses, [@Receita], ASC)
			
			VAR NomeMaior =
			    MAXX(MaiorMes, DimData[NomeMes])
			
			VAR ValorMaior =
			    MAXX(MaiorMes, [@Receita])
			
			VAR NomeMenor =
			    MAXX(MenorMes, DimData[NomeMes])
			
			VAR ValorMenor =
			    MINX(MenorMes, [@Receita])
			
			VAR MediaMensal =
			    AVERAGEX(TabelaMeses, [@Receita])
			
			RETURN
			
			NomeMaior &
			" liderou com " &
			FORMAT(ValorMaior, "R$ #,##0.00", "pt-BR") &
			" | " &
			NomeMenor &
			" foi o menor com " &
			FORMAT(ValorMenor, "R$ #,##0.00", "pt-BR") &
			" | Média: " &
			FORMAT(MediaMensal, "R$ #,##0.00", "pt-BR")
		displayFolder: HTML Insights
		lineageTag: ac084168-7f18-4a72-bac7-17b58f3fe893

	measure 'Clientes Ativos' =
			
			DISTINCTCOUNT(FatoVendas[ClienteID])
		formatString: 0
		displayFolder: KPIS (Total)
		lineageTag: bf48832e-d412-4efc-8d61-a11e00cce338

	measure 'Subtitulo Clientes Ativos' =
			
			VAR Atual =
			    [Clientes Ativos]
			
			VAR MesAnterior =
			    CALCULATE(
			        [Clientes Ativos],
			        DATEADD(DimData[Data], -1, MONTH)
			    )
			
			VAR Variacao =
			    DIVIDE(Atual - MesAnterior, MesAnterior)
			
			RETURN
			    "Clientes ativos no período • " &
			    FORMAT(Atual, "#,##0") &
			    " clientes • " &
			    IF(
			        Variacao > 0,
			        "▲ " & FORMAT(Variacao, "0.0%") & " vs. mês anterior",
			        IF(
			            Variacao < 0,
			            "▼ " & FORMAT(ABS(Variacao), "0.0%") & " vs. mês anterior",
			            "▬ estável vs. mês anterior"
			        )
			    )
		displayFolder: Subtítulos
		lineageTag: 9d9f9ca7-7bfe-48a8-9516-acc0b9a3104d

	measure 'Variação Clientes 3M' =
			
			VAR DataAtual =
			    MAX(DimData[Data])
			
			VAR ClientesAtual =
			    CALCULATE(
			        [Clientes Ativos],
			        DATESINPERIOD(
			            DimData[Data],
			            DataAtual,
			            -3,
			            MONTH
			        )
			    )
			
			VAR DataAnterior =
			    EDATE(DataAtual, -3)
			
			VAR ClientesAnterior =
			    CALCULATE(
			        [Clientes Ativos],
			        DATESINPERIOD(
			            DimData[Data],
			            DataAnterior,
			            -3,
			            MONTH
			        )
			    )
			
			RETURN
			    DIVIDE(
			        ClientesAtual - ClientesAnterior,
			        ClientesAnterior
			    )
		displayFolder: HTML Insights
		lineageTag: db211e14-539b-41ed-b1b0-2b02155480a0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Insight Clientes HTML' =
			
			VAR UltimaData =
			    CALCULATE(
			        MAX(FatoVendas[Data]),
			        ALLSELECTED(FatoVendas)
			    )
			
			VAR Inicio3MesesAtuais =
			    EOMONTH(UltimaData, -3) + 1
			
			VAR Inicio3MesesAnteriores =
			    EOMONTH(UltimaData, -6) + 1
			
			VAR Fim3MesesAnteriores =
			    EOMONTH(UltimaData, -3)
			
			VAR ClientesAtual =
			    CALCULATE(
			        [Clientes Ativos],
			        REMOVEFILTERS(DimData),
			        DATESBETWEEN(
			            DimData[Data],
			            Inicio3MesesAtuais,
			            UltimaData
			        )
			    )
			
			VAR ClientesAnterior =
			    CALCULATE(
			        [Clientes Ativos],
			        REMOVEFILTERS(DimData),
			        DATESBETWEEN(
			            DimData[Data],
			            Inicio3MesesAnteriores,
			            Fim3MesesAnteriores
			        )
			    )
			
			VAR Variacao =
			    DIVIDE(
			        ClientesAtual - ClientesAnterior,
			        ClientesAnterior,
			        BLANK()
			    )
			
			VAR Percentual =
			    FORMAT(ABS(Variacao), "0.0%")
			
			VAR Fundo =
			    SWITCH(
			        TRUE(),
			        Variacao > 0.05, "#EAF7EE",
			        Variacao < -0.05, "#FDECEC",
			        "#F5F5F5"
			    )
			
			VAR Cor =
			    SWITCH(
			        TRUE(),
			        Variacao > 0.05, "#2E7D32",
			        Variacao < -0.05, "#C62828",
			        "#666666"
			    )
			
			VAR Icone =
			    SWITCH(
			        TRUE(),
			        Variacao > 0.05, "✓",
			        Variacao < -0.05, "⚠",
			        "●"
			    )
			
			VAR Titulo =
			    SWITCH(
			        TRUE(),
			        Variacao > 0.05, "Cenário positivo",
			        Variacao < -0.05, "Atenção",
			        "Base estável"
			    )
			
			VAR Mensagem =
			    SWITCH(
			        TRUE(),
			
			        ISBLANK(Variacao),
			            "Não há dados suficientes para avaliar a evolução recente da base de clientes.",
			
			        Variacao > 0.05,
			            "A base de clientes ativos cresceu " &
			            Percentual &
			            " nos últimos 3 meses. O cenário indica uma evolução positiva da base e oportunidade para ampliar ainda mais a retenção.",
			
			        Variacao < -0.05,
			            "A base de clientes ativos caiu " &
			            Percentual &
			            " nos últimos 3 meses. Vale investigar possíveis impactos de preços, promoções ou ações de marketing.",
			
			        "A base de clientes ativos permaneceu estável nos últimos 3 meses. O cenário indica uma base consistente, mas ainda existe espaço para crescimento."
			    )
			
			RETURN
			
			"<div style='
			    width:100%;
			    box-sizing:border-box;
			    background:" & Fundo & ";
			    border-left:5px solid " & Cor & ";
			    border-radius:10px;
			    padding:18px 22px;
			    font-family:Segoe UI;
			'>
			
			    <div style='
			        color:" & Cor & ";
			        font-size:16px;
			        font-weight:700;
			        margin-bottom:8px;
			    '>
			        " & Icone & " " & Titulo & "
			    </div>
			
			    <div style='
			        color:#333333;
			        font-size:14px;
			        line-height:1.55;
			    '>
			        " & Mensagem & "
			    </div>
			
			</div>"
		displayFolder: HTML Insights
		lineageTag: d705648c-0819-44f8-b621-b689c3fc56a6

	measure 'Clientes PF' =
			
