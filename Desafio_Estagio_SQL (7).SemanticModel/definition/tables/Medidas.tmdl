			    -- Número 2°
			    "<div style='width: 44px; height: 44px; left: 35px; top: 138px; position: absolute; text-align: center; justify-content: center; display: flex; flex-direction: column; color: #7A7A7A; font-size: 18px; font-family: Segoe UI, sans-serif; font-weight: 600;'>2°</div>" &
			    -- Loja 2
			    "<div style='width: 380px; height: 44px; left: 94px; top: 138px; position: absolute; justify-content: center; display: flex; flex-direction: column; color: #7A7A7A; font-size: 16px; font-family: Segoe UI, sans-serif; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;'>" & _Loja2 & "</div>" &
			    -- Valor 2
			    "<div style='width: 200px; height: 44px; right: 35px; top: 138px; position: absolute; text-align: right; justify-content: center; display: flex; flex-direction: column; color: #303030; font-size: " & _Fonte2 & "px; font-family: Segoe UI, sans-serif; font-weight: 700; white-space: nowrap;'>" & _Txt2 & "</div>" &
			
			    -- ====== LINHA 3 (3º LUGAR) ======
			    -- Quadrado cinza claro
			    "<div style='width: 44px; height: 44px; left: 35px; top: 206px; position: absolute; background: #F6F6F6; border-radius: 7px;'></div>" &
			    -- Número 3°
			    "<div style='width: 44px; height: 44px; left: 35px; top: 206px; position: absolute; text-align: center; justify-content: center; display: flex; flex-direction: column; color: #7A7A7A; font-size: 18px; font-family: Segoe UI, sans-serif; font-weight: 600;'>3°</div>" &
			    -- Loja 3
			    "<div style='width: 380px; height: 44px; left: 94px; top: 206px; position: absolute; justify-content: center; display: flex; flex-direction: column; color: #7A7A7A; font-size: 16px; font-family: Segoe UI, sans-serif; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;'>" & _Loja3 & "</div>" &
			    -- Valor 3
			    "<div style='width: 200px; height: 44px; right: 35px; top: 206px; position: absolute; text-align: right; justify-content: center; display: flex; flex-direction: column; color: #303030; font-size: " & _Fonte3 & "px; font-family: Segoe UI, sans-serif; font-weight: 700; white-space: nowrap;'>" & _Txt3 & "</div>" &
			
			"</div>"
			```
		lineageTag: b28bd4bb-aa72-4999-acc0-5b5b34d06162
		dataCategory: Uncategorized

	measure Visual_HTML_Top3_Piores_Loja = ```
			
			VAR _ParametroSelecionado = TRIM(UPPER(MAX('Filtro dos Cartões da Pagina Executivo'[Parâmetro])))
			
			-- 1. Valor de cada Loja (filtrando lojas inválidas: blank, nula ou "Não Identificado")
			VAR _TabelaBase =
			    ADDCOLUMNS(
			        FILTER(
			            VALUES('DimVendedor'[Loja]),
			            NOT ISBLANK('DimVendedor'[Loja]) 
			            && 'DimVendedor'[Loja] <> "" 
			            && UPPER(TRIM('DimVendedor'[Loja])) <> "NÃO IDENTIFICADO"
			            && UPPER(TRIM('DimVendedor'[Loja])) <> "NAO IDENTIFICADO"
			        ),
			        "@Valor",
			            VAR _Loja = 'DimVendedor'[Loja]
			            RETURN
			            SWITCH(
			                TRUE(),
			                _ParametroSelecionado = "RECEITA TOTAL", CALCULATE([Receita Total], FILTER(ALL('DimVendedor'), 'DimVendedor'[Loja] = _Loja)),
			                _ParametroSelecionado = "QTD TOTAL", CALCULATE([Qtd Total], FILTER(ALL('DimVendedor'), 'DimVendedor'[Loja] = _Loja)),
			                _ParametroSelecionado = "TICKET MÉDIO", CALCULATE([Ticket Médio], FILTER(ALL('DimVendedor'), 'DimVendedor'[Loja] = _Loja)),
			                _ParametroSelecionado = "LUCRO TOTAL", CALCULATE([Lucro Total], FILTER(ALL('DimVendedor'), 'DimVendedor'[Loja] = _Loja)),
			                _ParametroSelecionado = "MARGEM DE LUCRO %", CALCULATE([Margem de Lucro %], FILTER(ALL('DimVendedor'), 'DimVendedor'[Loja] = _Loja)),
			                CALCULATE([Receita Total], FILTER(ALL('DimVendedor'), 'DimVendedor'[Loja] = _Loja))
			            )
			    )
			
			-- 2. Top 3 PIORES Lojas (ASC = menores valores), removendo valores em branco
			VAR _Top3 = 
			    TOPN(
			        3, 
			        FILTER(_TabelaBase, NOT ISBLANK([@Valor]) && [@Valor] <> 0), 
			        [@Valor], 
			        ASC
			    )
			VAR _TabelaRank = ADDCOLUMNS(_Top3, "@Rank", RANKX(_Top3, [@Valor],, ASC, DENSE))
			
			VAR _Loja1 = MAXX(FILTER(_TabelaRank, [@Rank] = 1), 'DimVendedor'[Loja])
			VAR _Val1 = MAXX(FILTER(_TabelaRank, [@Rank] = 1), [@Valor])
			VAR _Loja2 = MAXX(FILTER(_TabelaRank, [@Rank] = 2), 'DimVendedor'[Loja])
			VAR _Val2 = MAXX(FILTER(_TabelaRank, [@Rank] = 2), [@Valor])
			VAR _Loja3 = MAXX(FILTER(_TabelaRank, [@Rank] = 3), 'DimVendedor'[Loja])
			VAR _Val3 = MAXX(FILTER(_TabelaRank, [@Rank] = 3), [@Valor])
			
			-- Fallback caso não haja lojas
			VAR _Loja1_Final = IF(ISBLANK(_Loja1), "—", _Loja1)
			VAR _Loja2_Final = IF(ISBLANK(_Loja2), "—", _Loja2)
			VAR _Loja3_Final = IF(ISBLANK(_Loja3), "—", _Loja3)
			
			-- 3. Formatação do texto
			VAR _Txt1 = 
			    SWITCH(
			        TRUE(),
			        _ParametroSelecionado = "MARGEM DE LUCRO %", FORMAT(_Val1, "0.0%"),
			        _ParametroSelecionado = "QTD TOTAL", FORMAT(_Val1, "#,##0"),
			        FORMAT(_Val1, "R$ #,##0.00")
			    )
			VAR _Txt2 = 
			    SWITCH(
			        TRUE(),
			        _ParametroSelecionado = "MARGEM DE LUCRO %", FORMAT(_Val2, "0.0%"),
			        _ParametroSelecionado = "QTD TOTAL", FORMAT(_Val2, "#,##0"),
			        FORMAT(_Val2, "R$ #,##0.00")
			    )
			VAR _Txt3 = 
			    SWITCH(
			        TRUE(),
			        _ParametroSelecionado = "MARGEM DE LUCRO %", FORMAT(_Val3, "0.0%"),
			        _ParametroSelecionado = "QTD TOTAL", FORMAT(_Val3, "#,##0"),
			        FORMAT(_Val3, "R$ #,##0.00")
			    )
			
			-- 4. Fonte dinâmica
			VAR _Fonte1 = IF(LEN(_Txt1) > 10, 17, 20)
			VAR _Fonte2 = IF(LEN(_Txt2) > 10, 16, 19)
			VAR _Fonte3 = IF(LEN(_Txt3) > 10, 16, 19)
			
			RETURN
			"<div style='width: 727px; height: 273px; position: relative; background: white; overflow: hidden; border-radius: 9px; outline: 1px #DBDFE5 solid; outline-offset: -1px; font-family: Segoe UI, sans-serif;'>" &
			
			    -- ====== LINHA 1 (1º LUGAR - PIOR) ======
			    "<div style='width: 44px; height: 44px; left: 35px; top: 70px; position: absolute; background: #C0392B; border-radius: 7px;'></div>" &
			    "<div style='width: 44px; height: 44px; left: 35px; top: 70px; position: absolute; text-align: center; justify-content: center; display: flex; flex-direction: column; color: #FFFFFF; font-size: 18px; font-family: Segoe UI, sans-serif; font-weight: 700;'>1°</div>" &
			    "<div style='width: 380px; height: 44px; left: 94px; top: 70px; position: absolute; justify-content: center; display: flex; flex-direction: column; color: #C0392B; font-size: 16px; font-family: Segoe UI, sans-serif; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;'>" & _Loja1_Final & "</div>" &
			    "<div style='width: 200px; height: 44px; right: 35px; top: 70px; position: absolute; text-align: right; justify-content: center; display: flex; flex-direction: column; color: #C0392B; font-size: " & _Fonte1 & "px; font-family: Segoe UI, sans-serif; font-weight: 700; white-space: nowrap;'>" & _Txt1 & "</div>" &
			
			    -- ====== LINHA 2 (2º LUGAR - PIOR) ======
			    "<div style='width: 44px; height: 44px; left: 35px; top: 138px; position: absolute; background: #FADBD8; border-radius: 7px;'></div>" &
			    "<div style='width: 44px; height: 44px; left: 35px; top: 138px; position: absolute; text-align: center; justify-content: center; display: flex; flex-direction: column; color: #C0392B; font-size: 18px; font-family: Segoe UI, sans-serif; font-weight: 600;'>2°</div>" &
			    "<div style='width: 380px; height: 44px; left: 94px; top: 138px; position: absolute; justify-content: center; display: flex; flex-direction: column; color: #7A7A7A; font-size: 16px; font-family: Segoe UI, sans-serif; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;'>" & _Loja2_Final & "</div>" &
			    "<div style='width: 200px; height: 44px; right: 35px; top: 138px; position: absolute; text-align: right; justify-content: center; display: flex; flex-direction: column; color: #C0392B; font-size: " & _Fonte2 & "px; font-family: Segoe UI, sans-serif; font-weight: 700; white-space: nowrap;'>" & _Txt2 & "</div>" &
			
			    -- ====== LINHA 3 (3º LUGAR - PIOR) ======
			    "<div style='width: 44px; height: 44px; left: 35px; top: 206px; position: absolute; background: #FADBD8; border-radius: 7px;'></div>" &
			    "<div style='width: 44px; height: 44px; left: 35px; top: 206px; position: absolute; text-align: center; justify-content: center; display: flex; flex-direction: column; color: #C0392B; font-size: 18px; font-family: Segoe UI, sans-serif; font-weight: 600;'>3°</div>" &
			    "<div style='width: 380px; height: 44px; left: 94px; top: 206px; position: absolute; justify-content: center; display: flex; flex-direction: column; color: #7A7A7A; font-size: 16px; font-family: Segoe UI, sans-serif; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;'>" & _Loja3_Final & "</div>" &
			    "<div style='width: 200px; height: 44px; right: 35px; top: 206px; position: absolute; text-align: right; justify-content: center; display: flex; flex-direction: column; color: #C0392B; font-size: " & _Fonte3 & "px; font-family: Segoe UI, sans-serif; font-weight: 700; white-space: nowrap;'>" & _Txt3 & "</div>" &
			
			"</div>"
			```
		lineageTag: 0a06c2ed-5323-46cc-8830-7dedb3d5709f
		dataCategory: Uncategorized

	measure Texto_Metrica_Ano = ```
			
			VAR _TextoBruto = 
			    CALCULATE(
			        SELECTEDVALUE( 'Filtro dos Cartões da Pagina Executivo'[Parâmetro Campos], "Métrica" )
			    )
			
			-- Extrai apenas o texto dentro dos colchetes [ ]
			VAR _Inicio = FIND( "[", _TextoBruto, 1, 0 ) + 1
			VAR _Fim = FIND( "]", _TextoBruto, 1, 0 )
			VAR _Tamanho = _Fim - _Inicio
			
			VAR _NomeLimpo = 
			    IF(
			        _Inicio > 1 && _Fim > 0,
			        MID( _TextoBruto, _Inicio, _Tamanho ),
			        _TextoBruto
			    )
			
			RETURN
			    _NomeLimpo & " ao Longo do Ano"
			```
		lineageTag: 5e915787-5dd6-4ef4-9cf2-dd55cd138cda

