	measure 'HTML Possíveis Soluções Clientes' =
			
			
			VAR ClientesAtual =
			    [Clientes Ativos]
			
			VAR NovosAtual =
			    [Novos Clientes]
			
			VAR RetencaoAtual =
			    [Clientes Ativos]
			
			VAR TopEstado =
			    TOPN(
			        1,
			        ALLSELECTED(DimCliente[Estado]),
			        CALCULATE([Clientes Ativos]),
			        DESC
			    )
			
			VAR NomeTopEstado =
			    CONCATENATEX(
			        TopEstado,
			        DimCliente[Estado],
			        ""
			    )
			
			RETURN
			
			"<div style='width:100%;height:100%;padding:22px 24px;background:#FFFFFF;font-family:Segoe UI,Arial,sans-serif;color:#0F172A;overflow-y:auto;'>
			
