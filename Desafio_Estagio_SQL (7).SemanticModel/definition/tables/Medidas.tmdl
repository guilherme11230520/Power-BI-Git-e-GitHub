			        _ParametroSelecionado = "QTD TOTAL", FORMAT(_Val2, "#,##0"),
			        FORMAT(_Val2, "R$ #,##0.00")
			    )
			VAR _Txt3 = 
			    SWITCH(
			        TRUE(),
			        _ParametroSelecionado = "MARGEM DE LUCRO %", FORMAT(_Val3, "0.0%"),
			        _ParametroSelecionado = "QTD TOTAL", FORMAT(_Val3, "#,##0"),
			        FORMAT(_Val3, "R$ #,##0.00")
			    )
			
			-- 4. Fonte dinâmica
			VAR _Fonte1 = IF(LEN(_Txt1) > 10, 17, 20)
			VAR _Fonte2 = IF(LEN(_Txt2) > 10, 16, 19)
			VAR _Fonte3 = IF(LEN(_Txt3) > 10, 16, 19)
			
			RETURN
			"<div style='width: 727px; height: 273px; position: relative; background: white; overflow: hidden; border-radius: 9px; outline: 1px #DBDFE5 solid; outline-offset: -1px; font-family: Segoe UI, sans-serif;'>" &
			
			    -- ====== LINHA 1 (1º LUGAR - MELHOR) ======
			    -- Quadrado cinza escuro (destaque)
			    "<div style='width: 44px; height: 44px; left: 35px; top: 70px; position: absolute; background: #303030; border-radius: 7px;'></div>" &
			    -- Número 1° em branco
			    "<div style='width: 44px; height: 44px; left: 35px; top: 70px; position: absolute; text-align: center; justify-content: center; display: flex; flex-direction: column; color: #FFFFFF; font-size: 18px; font-family: Segoe UI, sans-serif; font-weight: 700;'>1°</div>" &
			    -- Loja 1
			    "<div style='width: 380px; height: 44px; left: 94px; top: 70px; position: absolute; justify-content: center; display: flex; flex-direction: column; color: #303030; font-size: 16px; font-family: Segoe UI, sans-serif; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;'>" & _Loja1 & "</div>" &
			    -- Valor 1
			    "<div style='width: 200px; height: 44px; right: 35px; top: 70px; position: absolute; text-align: right; justify-content: center; display: flex; flex-direction: column; color: #303030; font-size: " & _Fonte1 & "px; font-family: Segoe UI, sans-serif; font-weight: 700; white-space: nowrap;'>" & _Txt1 & "</div>" &
			
			    -- ====== LINHA 2 (2º LUGAR) ======
