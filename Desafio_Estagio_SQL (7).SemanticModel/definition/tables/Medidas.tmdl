	measure 'Retencao Clientes' =
			
			
			VAR DataAtual =
			    MAX(DimData[Data])
			
			VAR InicioMesAtual =
			    DATE(
			        YEAR(DataAtual),
			        MONTH(DataAtual),
			        1
			    )
			
			VAR FimMesAtual =
			    EOMONTH(
			        InicioMesAtual,
			        0
			    )
			
			VAR InicioMesAnterior =
			    EOMONTH(
			        InicioMesAtual,
			        -2
			    ) + 1
			
			VAR FimMesAnterior =
			    EOMONTH(
			        InicioMesAtual,
			        -1
			    )
			
			VAR ClientesAtual =
			    CALCULATETABLE(
			        VALUES(FatoVendas[ClienteID]),
			
			        REMOVEFILTERS(DimData),
			
			        DATESBETWEEN(
			            DimData[Data],
			            InicioMesAtual,
			            FimMesAtual
			        )
			    )
			
			VAR ClientesAnterior =
			    CALCULATETABLE(
			        VALUES(FatoVendas[ClienteID]),
			
			        REMOVEFILTERS(DimData),
			
			        DATESBETWEEN(
			            DimData[Data],
			            InicioMesAnterior,
			            FimMesAnterior
			        )
			    )
			
			VAR ClientesRetidos =
			    COUNTROWS(
			        INTERSECT(
			            ClientesAtual,
			            ClientesAnterior
			        )
			    )
			
			VAR TotalAnterior =
			    COUNTROWS(
			        ClientesAnterior
			    )
			
			RETURN
			
			DIVIDE(
			    ClientesRetidos,
			    TotalAnterior,
			    BLANK()
			)
		displayFolder: KPIS (Total)
		lineageTag: 11dbe130-f766-412e-978f-fb9795e82d5d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'HTML Card Retencao' =
			
			
