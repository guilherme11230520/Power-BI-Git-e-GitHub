	measure Visual_HTML_Top3_melhor = ```
			
			VAR _ParametroSelecionado = TRIM(UPPER(MAX('Filtro dos Cartões da Pagina Executivo'[Parâmetro])))
			
			-- 1. Valor de cada Categoria (filtrando categorias inválidas)
			VAR _TabelaBase =
			    ADDCOLUMNS(
			        FILTER(
			            VALUES('DimCategoria'[Categoria]),
			            NOT ISBLANK('DimCategoria'[Categoria]) 
			            && 'DimCategoria'[Categoria] <> "" 
			            && UPPER(TRIM('DimCategoria'[Categoria])) <> "NÃO IDENTIFICADO"
			            && UPPER(TRIM('DimCategoria'[Categoria])) <> "NAO IDENTIFICADO"
			        ),
			        "@Valor",
			            VAR _Cat = 'DimCategoria'[Categoria]
			            RETURN
			            SWITCH(
			                TRUE(),
			                _ParametroSelecionado = "RECEITA TOTAL", CALCULATE([Receita Total], FILTER(ALL('DimCategoria'), 'DimCategoria'[Categoria] = _Cat)),
			                _ParametroSelecionado = "QTD TOTAL", CALCULATE([Qtd Total], FILTER(ALL('DimCategoria'), 'DimCategoria'[Categoria] = _Cat)),
			                _ParametroSelecionado = "TICKET MÉDIO", CALCULATE([Ticket Médio], FILTER(ALL('DimCategoria'), 'DimCategoria'[Categoria] = _Cat)),
			                _ParametroSelecionado = "LUCRO TOTAL", CALCULATE([Lucro Total], FILTER(ALL('DimCategoria'), 'DimCategoria'[Categoria] = _Cat)),
			                _ParametroSelecionado = "MARGEM DE LUCRO %", CALCULATE([Margem de Lucro %], FILTER(ALL('DimCategoria'), 'DimCategoria'[Categoria] = _Cat)),
			                CALCULATE([Receita Total], FILTER(ALL('DimCategoria'), 'DimCategoria'[Categoria] = _Cat))
			            )
			    )
			
			-- 2. Top 3 MELHORES Categorias (DESC = maiores valores)
			VAR _Top3 = 
			    TOPN(
			        3, 
			        FILTER(_TabelaBase, NOT ISBLANK([@Valor]) && [@Valor] <> 0), 
			        [@Valor], 
			        DESC
			    )
			VAR _TabelaRank = ADDCOLUMNS(_Top3, "@Rank", RANKX(_Top3, [@Valor],, DESC, DENSE))
			
			VAR _Cat1 = MAXX(FILTER(_TabelaRank, [@Rank] = 1), 'DimCategoria'[Categoria])
			VAR _Val1 = MAXX(FILTER(_TabelaRank, [@Rank] = 1), [@Valor])
			VAR _Cat2 = MAXX(FILTER(_TabelaRank, [@Rank] = 2), 'DimCategoria'[Categoria])
			VAR _Val2 = MAXX(FILTER(_TabelaRank, [@Rank] = 2), [@Valor])
			VAR _Cat3 = MAXX(FILTER(_TabelaRank, [@Rank] = 3), 'DimCategoria'[Categoria])
			VAR _Val3 = MAXX(FILTER(_TabelaRank, [@Rank] = 3), [@Valor])
			
			-- Fallback caso não haja categorias
			VAR _Cat1_Final = IF(ISBLANK(_Cat1), "—", _Cat1)
			VAR _Cat2_Final = IF(ISBLANK(_Cat2), "—", _Cat2)
			VAR _Cat3_Final = IF(ISBLANK(_Cat3), "—", _Cat3)
			
			-- 3. Formatação do texto
			VAR _Txt1 = 
			    SWITCH(
			        TRUE(),
			        _ParametroSelecionado = "MARGEM DE LUCRO %", FORMAT(_Val1, "0.0%"),
			        _ParametroSelecionado = "QTD TOTAL", FORMAT(_Val1, "#,##0"),
			        FORMAT(_Val1, "R$ #,##0.00")
			    )
			VAR _Txt2 = 
			    SWITCH(
			        TRUE(),
			        _ParametroSelecionado = "MARGEM DE LUCRO %", FORMAT(_Val2, "0.0%"),
			        _ParametroSelecionado = "QTD TOTAL", FORMAT(_Val2, "#,##0"),
			        FORMAT(_Val2, "R$ #,##0.00")
			    )
			VAR _Txt3 = 
			    SWITCH(
			        TRUE(),
			        _ParametroSelecionado = "MARGEM DE LUCRO %", FORMAT(_Val3, "0.0%"),
			        _ParametroSelecionado = "QTD TOTAL", FORMAT(_Val3, "#,##0"),
			        FORMAT(_Val3, "R$ #,##0.00")
			    )
			
			-- 4. Fonte dinâmica
			VAR _Fonte1 = IF(LEN(_Txt1) > 10, 17, 20)
			VAR _Fonte2 = IF(LEN(_Txt2) > 10, 16, 19)
			VAR _Fonte3 = IF(LEN(_Txt3) > 10, 16, 19)
			
			RETURN
			"<div style='width: 727px; height: 273px; position: relative; background: white; overflow: hidden; border-radius: 9px; outline: 1px #DBDFE5 solid; outline-offset: -1px; font-family: Segoe UI, sans-serif;'>" &
			
			    -- ====== LINHA 1 (1º LUGAR - MELHOR) ======
			    -- Quadrado cinza escuro (destaque)
			    "<div style='width: 44px; height: 44px; left: 35px; top: 70px; position: absolute; background: #303030; border-radius: 7px;'></div>" &
			    -- Número 1° em branco
			    "<div style='width: 44px; height: 44px; left: 35px; top: 70px; position: absolute; text-align: center; justify-content: center; display: flex; flex-direction: column; color: #FFFFFF; font-size: 18px; font-family: Segoe UI, sans-serif; font-weight: 700;'>1°</div>" &
			    -- Categoria 1
			    "<div style='width: 380px; height: 44px; left: 94px; top: 70px; position: absolute; justify-content: center; display: flex; flex-direction: column; color: #303030; font-size: 16px; font-family: Segoe UI, sans-serif; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;'>" & _Cat1_Final & "</div>" &
			    -- Valor 1
			    "<div style='width: 200px; height: 44px; right: 35px; top: 70px; position: absolute; text-align: right; justify-content: center; display: flex; flex-direction: column; color: #303030; font-size: " & _Fonte1 & "px; font-family: Segoe UI, sans-serif; font-weight: 700; white-space: nowrap;'>" & _Txt1 & "</div>" &
			
			    -- ====== LINHA 2 (2º LUGAR) ======
			    -- Quadrado cinza claro
			    "<div style='width: 44px; height: 44px; left: 35px; top: 138px; position: absolute; background: #F6F6F6; border-radius: 7px;'></div>" &
			    -- Número 2°
			    "<div style='width: 44px; height: 44px; left: 35px; top: 138px; position: absolute; text-align: center; justify-content: center; display: flex; flex-direction: column; color: #7A7A7A; font-size: 18px; font-family: Segoe UI, sans-serif; font-weight: 600;'>2°</div>" &
			    -- Categoria 2
			    "<div style='width: 380px; height: 44px; left: 94px; top: 138px; position: absolute; justify-content: center; display: flex; flex-direction: column; color: #7A7A7A; font-size: 16px; font-family: Segoe UI, sans-serif; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;'>" & _Cat2_Final & "</div>" &
			    -- Valor 2
			    "<div style='width: 200px; height: 44px; right: 35px; top: 138px; position: absolute; text-align: right; justify-content: center; display: flex; flex-direction: column; color: #303030; font-size: " & _Fonte2 & "px; font-family: Segoe UI, sans-serif; font-weight: 700; white-space: nowrap;'>" & _Txt2 & "</div>" &
			
			    -- ====== LINHA 3 (3º LUGAR) ======
			    -- Quadrado cinza claro
			    "<div style='width: 44px; height: 44px; left: 35px; top: 206px; position: absolute; background: #F6F6F6; border-radius: 7px;'></div>" &
			    -- Número 3°
			    "<div style='width: 44px; height: 44px; left: 35px; top: 206px; position: absolute; text-align: center; justify-content: center; display: flex; flex-direction: column; color: #7A7A7A; font-size: 18px; font-family: Segoe UI, sans-serif; font-weight: 600;'>3°</div>" &
			    -- Categoria 3
			    "<div style='width: 380px; height: 44px; left: 94px; top: 206px; position: absolute; justify-content: center; display: flex; flex-direction: column; color: #7A7A7A; font-size: 16px; font-family: Segoe UI, sans-serif; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;'>" & _Cat3_Final & "</div>" &
			    -- Valor 3
			    "<div style='width: 200px; height: 44px; right: 35px; top: 206px; position: absolute; text-align: right; justify-content: center; display: flex; flex-direction: column; color: #303030; font-size: " & _Fonte3 & "px; font-family: Segoe UI, sans-serif; font-weight: 700; white-space: nowrap;'>" & _Txt3 & "</div>" &
			
			"</div>"
			```
		lineageTag: 39752861-cfbd-48d2-8afd-cf10f5445c38
		dataCategory: Uncategorized

	measure Visual_HTML_Top3_Melhor_Loja = ```
			
			VAR _ParametroSelecionado = TRIM(UPPER(MAX('Filtro dos Cartões da Pagina Executivo'[Parâmetro])))
			
			-- 1. Valor de cada Loja conforme o parâmetro selecionado
			VAR _TabelaBase =
			    ADDCOLUMNS(
			        VALUES('DimVendedor'[Loja]),
			        "@Valor",
			            VAR _Loja = 'DimVendedor'[Loja]
