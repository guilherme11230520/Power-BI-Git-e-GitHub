	measure 'HTML Card Margem' =
			
			VAR Valor = [Margem de Lucro %]
			VAR MoM = [Crescimento Margem de Lucro %]
			VAR YoY = [Crescimento Margem de Lucro Anual %]
			
			VAR MoMTexto =
			    FORMAT(ABS(MoM), "0.00%", "pt-BR")
			
			VAR YoYTexto =
			    FORMAT(ABS(YoY), "0.00%", "pt-BR")
			
			VAR MoMCor =
			    IF(MoM >= 0, "#20C84F", "#FF4D4D")
			
			VAR YoYCor =
			    IF(YoY >= 0, "#20C84F", "#FF4D4D")
			
			VAR MoMSeta =
			    IF(MoM >= 0, "↑", "↓")
			
			VAR YoYSeta =
			    IF(YoY >= 0, "↑", "↓")
			
			VAR MoMBadge =
			    IF(MoM >= 0, "Crescimento", "Queda")
			
			VAR YoYBadge =
			    IF(YoY >= 0, "Crescimento", "Queda")
			
			RETURN
			"
			<div class='card'>
			
			    <div class='top'>
			
			        <div class='icon'>
			
			            <svg width='31' height='31' viewBox='0 0 32 32'>
			
			                <circle cx='13' cy='11'
			                        r='5'
			                        fill='none'
			                        stroke='#F3A21B'
			                        stroke-width='2'/>
			
			                <path d='M4 26C4 20.5 7.5 17 13 17C18.5 17 22 20.5 22 26'
			                      fill='none'
			                      stroke='#F3A21B'
			                      stroke-width='2'/>
			
			                <path d='M23 17V27'
			                      stroke='#F3A21B'
			                      stroke-width='2'/>
			
			                <path d='M18 22H28'
			                      stroke='#F3A21B'
			                      stroke-width='2'/>
			
			            </svg>
			
			        </div>
			
			        <div class='title'>
			            Margem de Lucro
			        </div>
			
			    </div>
			
			    <div class='value'>
			        " & FORMAT(Valor, "0.00%", "pt-BR") & "
			    </div>
			
			    <div class='indicator'>
			
			        <span class='label'>MoM:</span>
			
			        <span style='color:" & MoMCor & ";'>
			            " & MoMTexto & " " & MoMSeta & "
			        </span>
			
			        <span class='badge'
			              style='color:" & MoMCor & ";
			                     border-color:" & MoMCor & ";
			                     background:" &
			                     IF(MoM >= 0, "#DFF8E5", "#FFE1E1") & ";'>
			            " & MoMBadge & "
			        </span>
			
			    </div>
			
			    <div class='indicator'>
			
			        <span class='label'>YoY:</span>
			
			        <span style='color:" & YoYCor & ";'>
			            " & YoYTexto & " " & YoYSeta & "
			        </span>
			
			        <span class='badge'
			              style='color:" & YoYCor & ";
			                     border-color:" & YoYCor & ";
			                     background:" &
			                     IF(YoY >= 0, "#DFF8E5", "#FFE1E1") & ";'>
			            " & YoYBadge & "
			        </span>
			
			    </div>
			
			</div>
			
			<style>
			
			.card {
			    width: 100%;
			    height: 100%;
			    min-height: 175px;
			    box-sizing: border-box;
			    background: #FFFFFF;
			    border: 1px solid #D5DCE3;
			    border-radius: 11px;
			    padding: 14px 18px;
			    font-family: Arial, sans-serif;
			    transition:
			        box-shadow 0.28s ease,
			        transform 0.28s ease,
			        border-color 0.28s ease;
			    overflow: hidden;
			}
			
			.card:hover {
			    transform: translateY(-3px);
			    box-shadow: 0 8px 22px rgba(0,0,0,0.13);
			    border-color: #BFC8D1;
			}
			
			.top {
			    display: flex;
			    align-items: center;
			    gap: 14px;
			}
			
			.icon {
			    width: 48px;
			    height: 48px;
			    min-width: 48px;
			    border-radius: 10px;
			    background: #FFF0D4;
			    display: flex;
			    align-items: center;
			    justify-content: center;
			    transition: transform 0.3s ease;
			}
			
			.card:hover .icon {
			    transform: scale(1.08);
			}
			
			.title {
			    font-size: 24px;
			    color: #111111;
			    font-weight: 400;
			}
			
			.value {
			    margin-top: 10px;
			    font-size: 27px;
			    font-weight: 700;
			    color: #080808;
			}
			
			.indicator {
			    display: flex;
			    align-items: center;
			    height: 27px;
			    gap: 7px;
			    font-size: 16px;
			}
			
			.label {
			    color: #111111;
			}
			
			.badge {
			    margin-left: 5px;
			    padding: 2px 12px;
			    border-radius: 7px;
			    border: 1px solid;
			    font-size: 11px;
			    font-weight: 600;
			    transition: transform 0.2s ease;
			}
			
			.card:hover .badge {
			    transform: translateX(2px);
			}
			
			</style>
			"
		displayFolder: Cards de HTML
		lineageTag: e77ae081-87f7-41ca-96c7-a981c6700188

	measure 'HTML Tabela Produtos' =
			
			
			VAR TabelaProdutos =
			    ADDCOLUMNS(
			        VALUES(DimProduto[Produto]),
			        "@QuantidadeVendida", [Qtd Total],
			        "@EstoqueAtual", [Total Estoque],
			        "@ValorReceita", [Receita Total],
			        "@ValorLucro", [Lucro Total],
			        "@PercentualMargem", [Margem de Lucro %]
			    )
			
			VAR LinhasTabela =
			    CONCATENATEX(
			        TabelaProdutos,
			
			        VAR NomeProduto =
			            DimProduto[Produto]
			
			        VAR QuantidadeAtual =
			            [@QuantidadeVendida]
			
			        VAR EstoqueAtual =
			            [@EstoqueAtual]
			
			        VAR ReceitaAtual =
			            [@ValorReceita]
			
			        VAR LucroAtual =
			            [@ValorLucro]
			
			        VAR MargemAtual =
			            [@PercentualMargem]
			
			        VAR CorMargem =
			            SWITCH(
			                TRUE(),
			                MargemAtual > 0, "#15803D",
			                MargemAtual < 0, "#DC2626",
			                "#64748B"
			            )
			
			        VAR FundoMargem =
			            SWITCH(
			                TRUE(),
			                MargemAtual > 0, "#F0FDF4",
			                MargemAtual < 0, "#FEF2F2",
			                "#F8FAFC"
			            )
			
			        RETURN
			
			            "<div class='row'>" &
			
			                "<div class='cell product'>" &
			                    "<span class='product-name'>" &
			                        NomeProduto &
			                    "</span>" &
			                "</div>" &
			
			                "<div class='cell quantity'>" &
			                    FORMAT(
			                        QuantidadeAtual,
			                        "#,##0",
			                        "pt-BR"
			                    ) &
			                "</div>" &
			
			                "<div class='cell stock'>" &
			                    FORMAT(
			                        EstoqueAtual,
			                        "#,##0",
			                        "pt-BR"
			                    ) &
			                "</div>" &
			
			                "<div class='cell revenue'>" &
			                    "R$ " &
			                    FORMAT(
			                        ReceitaAtual,
			                        "#,##0.00",
			                        "pt-BR"
			                    ) &
			                "</div>" &
			
			                "<div class='cell profit'>" &
			                    "R$ " &
			                    FORMAT(
			                        LucroAtual,
			                        "#,##0.00",
			                        "pt-BR"
			                    ) &
			                "</div>" &
			
			                "<div class='cell margin'>" &
			                    "<span class='badge' " &
			                    "style='color:" &
			                    CorMargem &
			                    ";background:" &
			                    FundoMargem &
			                    ";'>" &
			                    FORMAT(
			                        MargemAtual,
			                        "0.00%",
			                        "pt-BR"
			                    ) &
			                    "</span>" &
			                "</div>" &
			
			            "</div>",
			
			        "",
			        DimProduto[Produto],
			        ASC
			    )
			
			RETURN
			
			"<div class='table-container'>
			
			    <!-- CABEÇALHO FIXO -->
			
			    <div class='header'>
			
			        <div class='header-cell product-header'>
			            Produto
			        </div>
			
			        <div class='header-cell'>
			            Total Vendido
			        </div>
			
			        <div class='header-cell'>
			            Estoque
			        </div>
			
			        <div class='header-cell'>
			            Receita
			        </div>
			
			        <div class='header-cell'>
			            Lucro
			        </div>
			
			        <div class='header-cell'>
			            Margem
			        </div>
			
			    </div>
			
			
			    <!-- TABELA -->
			
			    <div class='table-content'>
			
			        " &
			        LinhasTabela &
			        "
			
			    </div>
			
			</div>
			
			
			<style>
			
			/* =========================================
			   RESET
			   ========================================= */
			
			* {
			    box-sizing: border-box;
			}
			
			
			/* =========================================
			   CONTAINER
			   ========================================= */
			
			.table-container {
			
			    width: 100%;
			
			    min-height: 100%;
			
			    background: #FFFFFF;
			
			    font-family: Segoe UI, Arial, sans-serif;
			
			    color: #0F172A;
			
			    overflow: visible;
			
			    position: relative;
			}
			
			
			/* =========================================
			   CABEÇALHO FIXO
			   ========================================= */
			
			.header {
			
			    position: fixed !important;
			
			    top: 0 !important;
			
			    left: 0 !important;
			
			    right: 0 !important;
			
			    width: 100%;
			
			    height: 52px;
			
			    min-height: 52px;
			
			    display: grid;
			
			    grid-template-columns:
			        minmax(140px, 1.45fr)
			        minmax(105px, 0.95fr)
			        minmax(90px, 0.85fr)
			        minmax(125px, 1fr)
			        minmax(125px, 1fr)
			        minmax(90px, 0.85fr);
			
			    align-items: center;
			
			    padding: 0 17px;
			
			    background: #FFFFFF;
			
			    border-bottom: 1px solid #E5E7EB;
			
			    box-shadow:
			        0 2px 8px rgba(
			            15,
			            23,
			            42,
			            0.08
			        );
			
			    z-index: 9999;
			}
			
			
			/* =========================================
			   TÍTULOS
			   ========================================= */
			
			.header-cell {
			
			    padding: 4px 10px;
			
			    font-size: 11px;
			
			    font-weight: 600;
			
			    color: #64748B;
			
			    letter-spacing: 0.02em;
			
			    text-align: right;
			
			    white-space: nowrap;
			}
			
			
			.product-header {
			
			    text-align: left;
			}
			
			
			/* =========================================
			   CONTEÚDO DA TABELA
			   ========================================= */
			
			.table-content {
			
			    width: 100%;
			
			    padding-top: 57px;
			
			    padding-left: 9px;
			
			    padding-right: 9px;
			
			    padding-bottom: 12px;
			}
			
			
			/* =========================================
			   LINHAS
			   ========================================= */
			
			.row {
			
			    position: relative;
			
			    display: grid;
			
			    grid-template-columns:
			        minmax(140px, 1.45fr)
			        minmax(105px, 0.95fr)
			        minmax(90px, 0.85fr)
			        minmax(125px, 1fr)
			        minmax(125px, 1fr)
			        minmax(90px, 0.85fr);
			
			    align-items: center;
			
			    min-height: 56px;
			
			    margin: 3px 0;
			
			    padding: 7px 8px;
			
			    border-radius: 10px;
			
			    background: #FFFFFF;
			
			    transition:
			        background 0.18s ease,
			        transform 0.18s ease,
			        box-shadow 0.18s ease;
			}
			
			
			/* =========================================
			   HOVER
			   ========================================= */
			
			.row:hover {
			
			    background: #F8FAFC;
			
			    transform: translateY(-1px);
			
			    box-shadow:
			        0 5px 15px rgba(
			            15,
			            23,
			            42,
			            0.055
			        );
			}
			
			
			/* =========================================
			   BARRA LATERAL DO HOVER
			   ========================================= */
			
			.row:before {
			
			    content: '';
			
			    position: absolute;
			
			    left: 0;
			
			    top: 13px;
			
			    bottom: 13px;
			
			    width: 3px;
			
			    border-radius: 0 4px 4px 0;
			
			    background: #CBD5E1;
			
			    opacity: 0;
			
			    transition: opacity 0.18s ease;
			}
			
			
			.row:hover:before {
			
			    opacity: 1;
			}
			
			
			/* =========================================
			   CÉLULAS
			   ========================================= */
			
			.cell {
			
			    min-width: 0;
			
			    padding: 6px 10px;
			
			    font-size: 13px;
			
			    line-height: 1.35;
			
			    white-space: nowrap;
			
			    overflow: hidden;
			
			    text-overflow: ellipsis;
			
			    font-variant-numeric: tabular-nums;
			}
			
			
			/* =========================================
			   PRODUTO
			   ========================================= */
			
			.product {
			
			    text-align: left;
			}
			
			
			.product-name {
			
			    color: #334155;
			
			    font-weight: 500;
			
			    transition: color 0.18s ease;
			}
			
			
			.row:hover .product-name {
			
			    color: #0F172A;
			
			    font-weight: 600;
			}
			
			
			/* =========================================
			   TOTAL VENDIDO
			   ========================================= */
			
			.quantity {
			
			    text-align: right;
			
			    color: #334155;
			
			    font-weight: 600;
			}
			
			
			/* =========================================
			   ESTOQUE
			   ========================================= */
			
			.stock {
			
			    text-align: right;
			
			    color: #475569;
			
			    font-weight: 500;
			}
			
			
			/* =========================================
			   RECEITA
			   ========================================= */
			
			.revenue {
			
			    text-align: right;
			
			    color: #475569;
			
			    font-weight: 500;
			}
			
			
			/* =========================================
			   LUCRO
			   ========================================= */
			
			.profit {
			
			    text-align: right;
			
			    color: #0F172A;
			
			    font-weight: 600;
			}
			
			
			/* =========================================
			   MARGEM
			   ========================================= */
			
			.margin {
			
			    text-align: right;
			}
			
			
			.badge {
			
			    display: inline-flex;
			
			    align-items: center;
			
			    justify-content: center;
			
			    min-width: 70px;
			
			    padding: 5px 9px;
			
			    border-radius: 7px;
			
			    font-size: 11px;
			
			    font-weight: 600;
			
			    font-variant-numeric: tabular-nums;
			
			    transition:
			        transform 0.18s ease,
			        box-shadow 0.18s ease;
			}
			
			
			.row:hover .badge {
			
			    transform: translateY(-1px);
			
			    box-shadow:
			        0 3px 8px rgba(
			            15,
			            23,
			            42,
			            0.07
			        );
			}
			
			</style>"
		displayFolder: Executivo Tabela HTML
		lineageTag: 04f51b0c-b44d-4801-ae5c-c01dfb066d48

	measure 'Total Estoque' = SUM(DimProduto[Estoque])
		formatString: 0
		displayFolder: KPIS (Total)
		lineageTag: afe7f71a-8868-4e9d-bd13-293631471c13

	measure 'Cor Receita Produto' =
			
			VAR ReceitaAtual =
			    [Receita Total]
			
			VAR MaiorReceita =
			    MAXX(
			        ALLSELECTED(DimProduto[Produto]),
			        [Receita Total]
			    )
			
			VAR MenorReceita =
			    MINX(
			        ALLSELECTED(DimProduto[Produto]),
			        [Receita Total]
			    )
			
			RETURN
			    SWITCH(
			        TRUE(),
			        ReceitaAtual = MaiorReceita, "#9CE3A4",   -- Verde
			        ReceitaAtual = MenorReceita, "#FF8095",   -- Vermelho
			        "#94B6FF"                                 -- Preto/Grafite
			    )
		displayFolder: Clientes Medidas
		lineageTag: 5c85d113-261e-40c6-9146-21d9727aa767

	measure 'Subtitulo Produtos' =
			
			
			VAR ProdutoMaisVendido =
			    TOPN(
			        1,
			        ADDCOLUMNS(
			            VALUES(DimProduto[Produto]),
			            "@Qtd", [Qtd Total]
			        ),
			        [@Qtd], DESC,
			        DimProduto[Produto], ASC
			    )
			
			VAR NomeMaisVendido =
			    MAXX(
			        ProdutoMaisVendido,
			        DimProduto[Produto]
			    )
			
			VAR QtdMaisVendida =
			    MAXX(
			        ProdutoMaisVendido,
			        [@Qtd]
			    )
			
			VAR ProdutoMaiorLucro =
			    TOPN(
			        1,
			        ADDCOLUMNS(
			            VALUES(DimProduto[Produto]),
			            "@Lucro", [Lucro Total]
			        ),
			        [@Lucro], DESC,
			        DimProduto[Produto], ASC
			    )
			
			VAR NomeMaiorLucro =
			    MAXX(
			        ProdutoMaiorLucro,
			        DimProduto[Produto]
			    )
			
			VAR MaiorLucro =
			    MAXX(
			        ProdutoMaiorLucro,
			        [@Lucro]
			    )
			
			RETURN
			
			IF(
			    NomeMaisVendido = NomeMaiorLucro,
			
			    NomeMaisVendido
			        & " é o grande destaque, com "
			        & FORMAT(QtdMaisVendida, "#,##0", "pt-BR")
			        & " unidades vendidas e "
			        & FORMAT(MaiorLucro, "R$ #,##0.00", "pt-BR")
			        & " em lucro.",
			
			    NomeMaisVendido
			        & " lidera as vendas, enquanto "
			        & NomeMaiorLucro
			        & " apresenta o maior lucro."
			)
		displayFolder: Subtítulos
		lineageTag: 7cf53f25-5910-486d-908a-d27b99ff85da

