	measure 'Novos Clientes' =
			
			
			VAR DataInicioPeriodo =
			    MIN(DimData[Data])
			
			VAR DataFimPeriodo =
			    MAX(DimData[Data])
			
			VAR DataMinimaBase =
			    CALCULATE(
			        MIN(FatoVendas[Data]),
			        REMOVEFILTERS(DimData),
			        REMOVEFILTERS(DimCliente)
			    )
			
			VAR PrimeiroAnoBase =
			    YEAR(DataMinimaBase)
			
			VAR AnoAtual =
			    YEAR(DataInicioPeriodo)
			
			VAR ClientesNovos =
			    FILTER(
			        VALUES(DimCliente[ClienteID]),
			
			        VAR ClienteAtual =
			            DimCliente[ClienteID]
			
			        VAR PrimeiraCompra =
			            CALCULATE(
			                MIN(FatoVendas[Data]),
			                REMOVEFILTERS(DimData),
			                REMOVEFILTERS(DimCliente),
			                DimCliente[ClienteID] = ClienteAtual
			            )
			
			        RETURN
			            PrimeiraCompra >= DataInicioPeriodo
			                && PrimeiraCompra <= DataFimPeriodo
			    )
			
			RETURN
			
			IF(
			    AnoAtual = PrimeiroAnoBase,
			    0,
			    COUNTROWS(ClientesNovos)
			)
		formatString: 0
		displayFolder: KPIS (Total)
		lineageTag: 9754e29d-c770-48fa-a2b5-416371e5ca1c

	measure 'HTML Card Novos Clientes' =
			
			
			VAR Novos =
			    [Novos Clientes]
			
			RETURN
			
			"<div class='card'>
			
			    <div class='top'>
			
			        <div class='icon'>
			
			            <svg width='34' height='34'
			                 viewBox='0 0 34 34'
			                 fill='none'
