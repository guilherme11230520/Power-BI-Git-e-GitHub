	measure 'HTML Clientes Segmento' =
			
			VAR Total = [Clientes Ativos]
			VAR PF = [Clientes PF]
			VAR PJ = [Clientes PJ]
			
			VAR PercPF = DIVIDE(PF, Total, 0)
			VAR PercPJ = DIVIDE(PJ, Total, 0)
			
			VAR Diferenca = ABS(PercPF - PercPJ)
			
			VAR SegmentoMaior =
			    IF(PF >= PJ, "Pessoa Física", "Pessoa Jurídica")
			
			VAR CorPF = "#111111"
			VAR CorPJ = "#A3A3A3"
			
			VAR HtmlCode =
			
			"<div style='
			width:100%;
