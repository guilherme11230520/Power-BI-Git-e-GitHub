	measure TituloGraficoDeBarrasP4 = ```
			
			VAR _TextoBruto = 
			    CALCULATE(
			        SELECTEDVALUE( 'Grafico de Barra da Pagina de Vendedor'[Grafico de Barra da Pagina de Vendedor Campos], "Métrica" )
			    )
			
			-- Extrai apenas o texto dentro dos colchetes [ ]
			VAR _Inicio = FIND( "[", _TextoBruto, 1, 0 ) + 1
			VAR _Fim = FIND( "]", _TextoBruto, 1, 0 )
			VAR _Tamanho = _Fim - _Inicio
			
			VAR _NomeLimpo = 
			    IF(
			        _Inicio > 1 && _Fim > 0,
			        MID( _TextoBruto, _Inicio, _Tamanho ),
			        _TextoBruto
			    )
			
			RETURN
			    _NomeLimpo & " por Vendedor"
			```
		lineageTag: abc12a15-bcf2-439c-9bb7-c2e4cc0f8bc0

	measure SubTituloGraficoDeBarrasP4 =
			
