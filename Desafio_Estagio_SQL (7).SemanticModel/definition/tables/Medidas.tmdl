			                        "#,##0.00",
			                        "pt-BR"
			                    ) &
			                "</div>" &
			
			                "<div class='cell margin'>" &
			                    "<span class='badge' " &
			                    "style='color:" &
			                    CorMargem &
			                    ";background:" &
			                    FundoMargem &
			                    ";'>" &
			                    FORMAT(
			                        MargemAtual,
			                        "0.00%",
			                        "pt-BR"
			                    ) &
			                    "</span>" &
			                "</div>" &
			
			            "</div>",
			
			        "",
			        [@QuantidadeVendida],
			        DESC
			    )
			
			RETURN
			
			"<div class='table-container'>
			
			    <div class='header'>
			
			        <div class='header-cell product-header'>
			            Produto
			        </div>
			
			        <div class='header-cell'>
			            Total Vendido
			        </div>
			
			        <div class='header-cell'>
			            Estoque
			        </div>
			
			        <div class='header-cell'>
			            Receita
			        </div>
			
			        <div class='header-cell'>
			            Lucro
			        </div>
			
			        <div class='header-cell'>
			            Margem
			        </div>
			
			    </div>
			
			    <div class='table-content'>
			
			        " &
			        LinhasTabela &
			        "
			
			    </div>
			
			</div>
			
			<style>
			
			* {
			    box-sizing: border-box;
