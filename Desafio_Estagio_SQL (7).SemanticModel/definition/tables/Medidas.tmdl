	measure 'Crescimento Vendedores Total Anual %' =
			
			VAR ReceitaAtual =
			    [Qtd. Vendedores]
			
			VAR ReceitaAnoAnterior =
			    CALCULATE(
			        [Qtd. Vendedores],
			        DATEADD(DimData[Data], -1, YEAR)
			    )
			
			RETURN
			    DIVIDE(
			        ReceitaAtual - ReceitaAnoAnterior,
			        ReceitaAnoAnterior
			    )
		displayFolder: KPIS (% Anual)
		lineageTag: 71e8bab1-f575-4989-98f6-d545e17d0754

		annotation PBI_FormatHint = {"isGeneralNumber":true}

