	measure 'Ticket Médio' =
			
			DIVIDE(
			    [Receita Total],
			    [Qtd Total],
			    0
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: KPIS (Total)
		lineageTag: e8e89c3d-c362-44a4-8e3f-0d67c0ad8677

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'HTML Card Ticket Médio' =
			
			
			VAR ReceitaAtual =
			    [Receita Total]
			
			VAR QuantidadeAtual =
			    [Qtd Total]
			
			VAR TicketAtual =
			    DIVIDE(
			        ReceitaAtual,
			        QuantidadeAtual,
			        0
			    )
			
			
			/* =========================================
			   TICKET MÉDIO DO ANO ANTERIOR
			   ========================================= */
			
			VAR ReceitaAnoAnterior =
			    CALCULATE(
			        [Receita Total],
			        SAMEPERIODLASTYEAR(
			            DimData[Data]
			        )
			    )
			
			VAR QuantidadeAnoAnterior =
			    CALCULATE(
			        [Qtd Total],
			        SAMEPERIODLASTYEAR(
			            DimData[Data]
			        )
			    )
			
			VAR TicketAnoAnterior =
			    DIVIDE(
			        ReceitaAnoAnterior,
			        QuantidadeAnoAnterior,
			        0
			    )
			
			
			/* =========================================
			   CRESCIMENTO YOY
			   ========================================= */
			
			VAR Crescimento =
			    DIVIDE(
			        TicketAtual - TicketAnoAnterior,
			        TicketAnoAnterior,
			        0
			    )
			
			VAR CorCrescimento =
			    IF(
			        Crescimento >= 0,
			        "#16B938",
			        "#DC2626"
			    )
			
			VAR FundoCrescimento =
			    IF(
			        Crescimento >= 0,
			        "#E9FBEF",
			        "#FEF2F2"
			    )
			
			VAR Seta =
			    IF(
			        Crescimento >= 0,
			        "↑",
			        "↓"
			    )
			
			
			RETURN
			
			"<div class='card'>
			
			    <div class='top'>
			
			        <div class='icon'>
			
			            <svg
			    width='34'
			    height='34'
			    viewBox='0 0 34 34'
			    fill='none'
			    xmlns='http://www.w3.org/2000/svg'>
			
			    <!-- Corpo da sacola -->
			
			    <rect
			        x='7'
			        y='11'
			        width='20'
			        height='17'
			        rx='3'
			        stroke='#F59E0B'
			        stroke-width='2'/>
			
			    <!-- Alça -->
			
			    <path
			        d='M12 11V9C12 6.8 14.2 5 17 5C19.8 5 22 6.8 22 9V11'
			        stroke='#F59E0B'
			        stroke-width='2'
			        stroke-linecap='round'/>
			
			    <!-- Símbolo R$ -->
			
			    <path
			        d='M17 15V24'
			        stroke='#F59E0B'
			        stroke-width='1.8'
			        stroke-linecap='round'/>
			
			    <path
			        d='M19.5 16.5C19.5 16.5 18.5 15 17 15C15.5 15 14.5 15.9 14.5 17C14.5 18.3 15.7 18.7 17 19C18.3 19.3 19.5 19.7 19.5 21C19.5 22.1 18.5 23 17 23C15.5 23 14.5 21.5 14.5 21.5'
			        stroke='#F59E0B'
			        stroke-width='1.8'
			        stroke-linecap='round'/>
			
			</svg>
			
			        </div>
			
			
			        <div
			            class='arrow'
			            style='color:" & CorCrescimento & ";'>
			
			            " & Seta & "
			
			        </div>
			
			    </div>
			
			
			    <div class='label'>
			        Ticket Médio
			    </div>
			
			
			    <div class='value'>
			
			        " &
			        FORMAT(
			            TicketAtual,
			            "R$ #,##0.00",
			            "pt-BR"
			        )
			        & "
			
			    </div>
			
			
			    <div class='comparison'>
			
			        <span
			            class='percentage'
			            style='
			                color:" & CorCrescimento & ";
			                background:" & FundoCrescimento & ";
			            '>
			
			            " &
			            FORMAT(
			                ABS(Crescimento),
			                "0%",
			                "pt-BR"
			            )
			            & "
			
			        </span>
			
			
			        <span class='comparison-text'>
			            Vs Ano Anterior
			        </span>
			
			    </div>
			
			</div>
			
			
			<style>
			
			/* =====================================
			   RESET
			   ===================================== */
			
			* {
			    box-sizing: border-box;
			}
			
			
			/* =====================================
			   CARD
			   ===================================== */
			
			.card {
			
			    width: 349px;
			
			    height: 208px;
			
			    padding: 30px 33px 25px 33px;
			
			    background: #FFFFFF;
			
			    border: 1px solid #E2E8F0;
			
			    border-radius: 8px;
			
			    font-family: Segoe UI, Arial, sans-serif;
			
			    position: relative;
			
			    overflow: hidden;
			
			    transition:
			        box-shadow 0.25s ease,
			        transform 0.25s ease,
			        border-color 0.25s ease;
			}
			
			
			/* =====================================
			   HOVER
			   ===================================== */
			
			.card:hover {
			
			    box-shadow:
			        0 10px 28px rgba(
			            15,
			            23,
			            42,
			            0.10
			        );
			
			    transform: translateY(-2px);
			
			    border-color: #D7DEE7;
			}
			
			
			/* =====================================
			   TOPO
			   ===================================== */
			
			.top {
			
			    width: 100%;
			
			    display: flex;
			
			    align-items: center;
			
			    justify-content: space-between;
			
			    margin-bottom: 13px;
			}
			
			
			/* =====================================
			   ÍCONE
			   ===================================== */
			
			.icon {
			
			    width: 34px;
			
			    height: 34px;
			
			    display: flex;
			
			    align-items: center;
			
			    justify-content: center;
			}
			
			
			/* =====================================
			   SETA
			   ===================================== */
			
			.arrow {
			
			    font-size: 29px;
			
			    font-weight: 300;
			
			    line-height: 1;
			
			    margin-right: 2px;
			
			    transition:
			        transform 0.25s ease;
			}
			
			
			.card:hover .arrow {
			
			    transform: translateY(-2px);
			}
			
			
			/* =====================================
			   LABEL
			   ===================================== */
			
			.label {
			
			    font-size: 16px;
			
			    font-weight: 600;
			
			    color: #999999;
			
			    margin-bottom: 8px;
			}
			
			
			/* =====================================
			   VALOR
			   ===================================== */
			
			.value {
			
			    font-size: 27px;
			
			    line-height: 1.1;
			
			    font-weight: 650;
			
			    color: #3F3F3F;
			
			    white-space: nowrap;
			
			    margin-bottom: 10px;
			}
			
			
			/* =====================================
			   COMPARAÇÃO
			   ===================================== */
			
			.comparison {
			
			    display: flex;
			
			    align-items: center;
			
			    gap: 6px;
			}
			
			
			/* =====================================
			   PERCENTUAL YOY
			   ===================================== */
			
			.percentage {
			
			    display: inline-flex;
			
			    align-items: center;
			
			    justify-content: center;
			
			    padding: 4px 10px;
			
			    min-height: 24px;
			
			    border-radius: 12px;
			
			    font-size: 13px;
			
			    font-weight: 650;
			
			    font-variant-numeric: tabular-nums;
			
			    white-space: nowrap;
			
			    transition:
			        transform 0.2s ease,
			        box-shadow 0.2s ease;
			}
			
			
			.card:hover .percentage {
			
			    transform: translateY(-1px);
			
			    box-shadow:
			        0 3px 8px rgba(
			            15,
			            23,
			            42,
			            0.06
			        );
			}
			
			
			/* =====================================
			   TEXTO COMPARATIVO
			   ===================================== */
			
			.comparison-text {
			
			    font-size: 13px;
			
			    font-weight: 500;
			
			    color: #A3A3A3;
			
			    white-space: nowrap;
			}
			
			</style>"
		displayFolder: Cards de HTML
		lineageTag: adb651bf-88e2-4978-8fd3-f3d03566353d

	measure 'HTML Pontos Positivos' =
			
			
			VAR ReceitaAtual = [Receita Total]
			VAR QtdAtual = [Qtd Total]
			VAR LucroAtual = [Lucro Total]
			VAR MargemAtual = [Margem de Lucro %]
			
			VAR TopProduto =
			    TOPN(
			        1,
			        ALLSELECTED(DimProduto[Produto]),
			        CALCULATE([Qtd Total]),
			        DESC
			    )
			
			VAR NomeTopProduto =
			    CONCATENATEX(
			        TopProduto,
			        DimProduto[Produto],
			        ""
			    )
			
			VAR QtdTopProduto =
			    MAXX(
			        TopProduto,
			        CALCULATE([Qtd Total])
			    )
			
			RETURN
			
			"<div style='width:100%;height:100%;padding:22px 24px;background:#FFFFFF;font-family:Segoe UI,Arial,sans-serif;color:#0F172A;overflow-y:auto;'>
			
			<div style='font-size:18px;font-weight:600;color:#0F172A;'>
			Pontos Positivos
			</div>
			
			<div style='margin-top:5px;font-size:12px;line-height:1.5;color:#64748B;'>
			Resultados que contribuíram positivamente para o desempenho do negócio.
			</div>
			
			<!-- =================================================
			ALTERE AQUI O ESPAÇO ENTRE SUBTÍTULO E LISTA
			Exemplo: 30px, 40px, 50px
			================================================= -->
			
			<div style='margin-top:70px;'>
			
			<div class='item'>
			<div class='text'>
			<div class='item-title'>Receita sólida no período</div>
			<div class='desc'>
			O negócio alcançou <strong>" &
			FORMAT(ReceitaAtual,"R$ #,##0.00","pt-BR") &
			"</strong> em receita, mantendo um volume financeiro relevante.
			</div>
			</div>
			<span class='badge green'>Receita</span>
			</div>
			
			<div class='item'>
			<div class='text'>
			<div class='item-title'>Bom volume de produtos vendidos</div>
			<div class='desc'>
			Foram comercializados <strong>" &
			FORMAT(QtdAtual,"#,##0","pt-BR") &
			"</strong> itens no período analisado.
			</div>
			</div>
			<span class='badge blue'>Vendas</span>
			</div>
			
			<div class='item'>
			<div class='text'>
			<div class='item-title'>Resultado positivo de lucratividade</div>
			<div class='desc'>
			O lucro acumulado chegou a <strong>" &
			FORMAT(LucroAtual,"R$ #,##0.00","pt-BR") &
			"</strong>, contribuindo para o resultado financeiro.
			</div>
			</div>
			<span class='badge green'>Lucro</span>
			</div>
			
			<div class='item'>
			<div class='text'>
			<div class='item-title'>Margem demonstra eficiência</div>
			<div class='desc'>
			A margem de lucro atual está em <strong>" &
			FORMAT(MargemAtual,"0.00%","pt-BR") &
			"</strong>, indicando boa capacidade de geração de resultado.
			</div>
			</div>
			<span class='badge green'>Margem</span>
			</div>
			
			<div class='item'>
			<div class='text'>
			<div class='item-title'>Produto líder em volume de vendas</div>
			<div class='desc'>
			<strong>" &
			NomeTopProduto &
			"</strong> lidera em quantidade vendida, com <strong>" &
			FORMAT(QtdTopProduto,"#,##0","pt-BR") &
			"</strong> unidades.
			</div>
			</div>
			<span class='badge blue'>Produto</span>
			</div>
			
			</div>
			
			<style>
			
			.item{
			display:flex;
			align-items:center;
			justify-content:space-between;
			gap:22px;
			min-height:78px;
			padding:14px 0;
			border-bottom:1px solid #EEF2F6;
			transition:all .18s ease;
			}
			
			.item:first-child{
			border-top:1px solid #EEF2F6;
			}
			
			.item:hover{
			background:#FAFCFB;
			padding-left:10px;
			padding-right:10px;
			border-radius:8px;
			}
			
			.text{
			flex:1;
			min-width:0;
			}
			
			.item-title{
			font-size:15px;
			font-weight:600;
			color:#0F172A;
			margin-bottom:6px;
			}
			
			.desc{
			font-size:13px;
			line-height:1.55;
			color:#64748B;
			}
			
			.desc strong{
			color:#334155;
			font-weight:600;
			}
			
			.badge{
			flex-shrink:0;
			padding:7px 12px;
			border-radius:7px;
			font-size:11px;
			font-weight:600;
			white-space:nowrap;
			}
			
			.green{
			color:#15803D;
			background:#F0FDF4;
			border:1px solid #BBF7D0;
			}
			
			.blue{
			color:#2563EB;
			background:#EFF6FF;
			border:1px solid #BFDBFE;
			}
			
			</style>
			
			</div>"
		displayFolder: HTML Insights
		lineageTag: 6a276d71-21e4-45d6-b401-94282804c18d

	measure 'HTML Pontos de Atenção' =
			
			
			VAR ReceitaAtual = [Receita Total]
			
			VAR ReceitaAnterior =
			    CALCULATE(
			        [Receita Total],
			        SAMEPERIODLASTYEAR(DimData[Data])
			    )
			
			VAR CrescimentoReceita =
			    DIVIDE(
			        ReceitaAtual - ReceitaAnterior,
			        ReceitaAnterior,
			        0
			    )
			
			VAR QtdAtual = [Qtd Total]
			
			VAR QtdAnterior =
			    CALCULATE(
			        [Qtd Total],
			        SAMEPERIODLASTYEAR(DimData[Data])
			    )
			
			VAR CrescimentoQtd =
			    DIVIDE(
			        QtdAtual - QtdAnterior,
			        QtdAnterior,
			        0
			    )
			
			VAR TicketAtual =
			    DIVIDE(
			        ReceitaAtual,
			        QtdAtual,
			        0
			    )
			
			VAR TicketAnterior =
			    DIVIDE(
			        ReceitaAnterior,
			        QtdAnterior,
			        0
			    )
			
			VAR CrescimentoTicket =
			    DIVIDE(
			        TicketAtual - TicketAnterior,
			        TicketAnterior,
			        0
			    )
			
			VAR ProdutosPrejuizo =
			    FILTER(
			        ALLSELECTED(DimProduto[Produto]),
			        CALCULATE([Lucro Total]) < 0
			    )
			
			VAR QuantidadePrejuizo =
			    COUNTROWS(ProdutosPrejuizo)
			
			VAR PiorProduto =
			    TOPN(
			        1,
			        ALLSELECTED(DimProduto[Produto]),
			        CALCULATE([Lucro Total]),
			        ASC
			    )
			
			VAR NomePiorProduto =
			    CONCATENATEX(
			        PiorProduto,
			        DimProduto[Produto],
			        ""
			    )
			
			VAR LucroPiorProduto =
			    MINX(
			        PiorProduto,
			        CALCULATE([Lucro Total])
			    )
			
			RETURN
			
			"<div style='width:100%;height:100%;padding:22px 24px;background:#FFFFFF;font-family:Segoe UI,Arial,sans-serif;color:#0F172A;overflow-y:auto;'>
			
			<div style='font-size:18px;font-weight:600;color:#0F172A;'>
			Pontos de Atenção
			</div>
			
			<div style='margin-top:5px;font-size:12px;line-height:1.5;color:#64748B;'>
			Resultados que apresentam quedas, riscos ou oportunidades que precisam de acompanhamento.
			</div>
			
			<!-- =================================================
			ALTERE AQUI O ESPAÇO ENTRE SUBTÍTULO E LISTA
			Exemplo: 30px, 40px, 50px
			================================================= -->
			
			<div style='margin-top:70px;'>
			
			<div class='item'>
			<div class='text'>
			<div class='item-title'>Receita apresenta variação</div>
			<div class='desc'>
			A receita apresentou uma variação de <strong>" &
			FORMAT(CrescimentoReceita,"0.00%","pt-BR") &
			"</strong> em relação ao ano anterior.
			</div>
			</div>
			<span class='badge red'>Receita</span>
			</div>
			
			<div class='item'>
			<div class='text'>
			<div class='item-title'>Volume de vendas exige acompanhamento</div>
			<div class='desc'>
			A quantidade de itens vendidos apresentou uma variação de <strong>" &
			FORMAT(CrescimentoQtd,"0.00%","pt-BR") &
			"</strong> contra o ano anterior.
			</div>
			</div>
			<span class='badge orange'>Vendas</span>
			</div>
			
			<div class='item'>
			<div class='text'>
			<div class='item-title'>Ticket médio apresenta mudança</div>
			<div class='desc'>
			O ticket médio atual é de <strong>" &
			FORMAT(TicketAtual,"R$ #,##0.00","pt-BR") &
			"</strong>, com variação de <strong>" &
			FORMAT(CrescimentoTicket,"0.00%","pt-BR") &
			"</strong> frente ao ano anterior.
			</div>
			</div>
			<span class='badge orange'>Ticket Médio</span>
			</div>
			
			<div class='item'>
			<div class='text'>
			<div class='item-title'>Produtos operando com prejuízo</div>
			<div class='desc'>
			Foram identificados <strong>" &
			FORMAT(QuantidadePrejuizo,"#,##0","pt-BR") &
			"</strong> produtos com lucro negativo no período.
			</div>
			</div>
			<span class='badge red'>Rentabilidade</span>
			</div>
			
			<div class='item'>
			<div class='text'>
			<div class='item-title'>Produto com pior resultado financeiro</div>
			<div class='desc'>
			<strong>" &
			NomePiorProduto &
			"</strong> apresenta o menor lucro, com resultado de <strong>" &
			FORMAT(LucroPiorProduto,"R$ #,##0.00","pt-BR") &
			"</strong>.
			</div>
			</div>
			<span class='badge red'>Produto</span>
			</div>
			
			</div>
			
			<style>
			
			.item{
			display:flex;
			align-items:center;
			justify-content:space-between;
			gap:22px;
			min-height:78px;
			padding:14px 0;
			border-bottom:1px solid #EEF2F6;
			transition:all .18s ease;
			}
			
			.item:first-child{
			border-top:1px solid #EEF2F6;
			}
			
			.item:hover{
			background:#FFFCFC;
			padding-left:10px;
			padding-right:10px;
			border-radius:8px;
			}
			
			.text{
			flex:1;
			min-width:0;
			}
			
			.item-title{
			font-size:15px;
			font-weight:600;
			color:#0F172A;
			margin-bottom:6px;
			}
			
			.desc{
			font-size:13px;
			line-height:1.55;
			color:#64748B;
			}
			
			.desc strong{
			color:#334155;
			font-weight:600;
			}
			
			.badge{
			flex-shrink:0;
			padding:7px 12px;
			border-radius:7px;
			font-size:11px;
			font-weight:600;
			white-space:nowrap;
			}
			
			.red{
			color:#DC2626;
			background:#FEF2F2;
			border:1px solid #FECACA;
			}
			
			.orange{
			color:#D97706;
			background:#FFFBEB;
			border:1px solid #FDE68A;
			}
			
			</style>
			
			</div>"
		displayFolder: HTML Insights
		lineageTag: e342751e-711a-4dbe-8d01-955bbb9bf87a

	measure 'HTML Possíveis Soluções' =
			
			
			VAR ReceitaAtual = [Receita Total]
			
			VAR QtdAtual = [Qtd Total]
			
			VAR TicketAtual =
			    DIVIDE(
			        ReceitaAtual,
			        QtdAtual,
			        0
			    )
			
			VAR TopProduto =
			    TOPN(
			        1,
			        ALLSELECTED(DimProduto[Produto]),
			        CALCULATE([Qtd Total]),
			        DESC
			    )
			
			VAR NomeTopProduto =
			    CONCATENATEX(
			        TopProduto,
			        DimProduto[Produto],
			        ""
			    )
			
			VAR PiorProduto =
			    TOPN(
			        1,
			        ALLSELECTED(DimProduto[Produto]),
			        CALCULATE([Lucro Total]),
			        ASC
			    )
			
			VAR NomePiorProduto =
			    CONCATENATEX(
			        PiorProduto,
			        DimProduto[Produto],
			        ""
			    )
			
			RETURN
			
			"<div style='width:100%;height:100%;padding:22px 24px;background:#FFFFFF;font-family:Segoe UI,Arial,sans-serif;color:#0F172A;overflow-y:auto;'>
			
			<div style='font-size:18px;font-weight:600;color:#0F172A;'>
			Possíveis Soluções
			</div>
			
			<div style='margin-top:5px;font-size:12px;line-height:1.5;color:#64748B;'>
			Estratégias que podem ser avaliadas para melhorar vendas, rentabilidade e eficiência comercial.
			</div>
			
			<!-- =================================================
			ALTERE AQUI O ESPAÇO ENTRE SUBTÍTULO E LISTA
			Exemplo: 30px, 40px, 50px
			================================================= -->
			
			<div style='margin-top:70px;'>
			
			<div class='item'>
			<div class='text'>
			<div class='item-title'>Potencializar o produto líder</div>
			<div class='desc'>
			O produto <strong>" &
			NomeTopProduto &
			"</strong> lidera em quantidade vendida. Aumentar sua exposição e disponibilidade pode ampliar o resultado comercial.
			</div>
			</div>
			<span class='badge purple'>Vendas</span>
			</div>
			
			<div class='item'>
			<div class='text'>
			<div class='item-title'>Trabalhar o aumento do ticket médio</div>
			<div class='desc'>
			Estratégias de <strong>upsell, cross-sell e kits</strong> podem aumentar o valor gerado por cada venda.
			</div>
			</div>
			<span class='badge blue'>Estratégia</span>
			</div>
			
			<div class='item'>
			<div class='text'>
			<div class='item-title'>Revisar produtos com baixa rentabilidade</div>
			<div class='desc'>
			O produto <strong>" &
			NomePiorProduto &
			"</strong> apresenta o pior resultado. Vale revisar preço, custo e margem antes de ampliar suas vendas.
			</div>
			</div>
			<span class='badge purple'>Rentabilidade</span>
			</div>
			
			<div class='item'>
			<div class='text'>
			<div class='item-title'>Priorizar produtos que geram lucro</div>
			<div class='desc'>
			Cruzar volume de vendas com lucro permite concentrar esforços nos produtos que realmente contribuem para o resultado financeiro.
			</div>
			</div>
			<span class='badge blue'>Performance</span>
			</div>
			
			<div class='item'>
