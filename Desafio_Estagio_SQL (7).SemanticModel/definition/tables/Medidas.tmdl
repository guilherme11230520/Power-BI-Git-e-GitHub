	measure 'HTML Pontos Positivos Executivo' =
			
			
			VAR ReceitaAtual = [Receita Total]
			VAR LucroAtual = [Lucro Total]
			VAR MargemAtual = [Margem de Lucro %]
			VAR QtdAtual = [Qtd Total]
			
			VAR ReceitaAnterior =
			    CALCULATE(
			        [Receita Total],
			        SAMEPERIODLASTYEAR(DimData[Data])
			    )
			
			VAR CrescimentoReceita =
			    DIVIDE(
			        ReceitaAtual - ReceitaAnterior,
			        ReceitaAnterior,
			        0
			    )
			
			VAR TicketAtual =
			    DIVIDE(
			        ReceitaAtual,
			        QtdAtual,
			        0
			    )
			
			VAR QtdAnterior =
			    CALCULATE(
			        [Qtd Total],
			        SAMEPERIODLASTYEAR(DimData[Data])
			    )
			
			VAR TicketAnterior =
			    DIVIDE(
			        ReceitaAnterior,
			        QtdAnterior,
			        0
			    )
			
			VAR CrescimentoTicket =
			    DIVIDE(
			        TicketAtual - TicketAnterior,
			        TicketAnterior,
			        0
			    )
			
			VAR TopProduto =
			    TOPN(
			        1,
			        ALLSELECTED(DimProduto[Produto]),
			        CALCULATE([Qtd Total]),
			        DESC
			    )
			
			VAR NomeTopProduto =
			    CONCATENATEX(
			        TopProduto,
			        DimProduto[Produto],
			        ""
			    )
			
			VAR QtdTopProduto =
			    MAXX(
			        TopProduto,
			        CALCULATE([Qtd Total])
			    )
			
			VAR MesesReceita =
			    ADDCOLUMNS(
			        ALLSELECTED(DimData[Mes]),
			        "@ReceitaMes",
			        CALCULATE([Receita Total])
			    )
			
			VAR MelhorMes =
			    TOPN(
			        1,
			        MesesReceita,
			        [@ReceitaMes],
			        DESC
			    )
			
			VAR NomeMelhorMes =
			    CONCATENATEX(
			        MelhorMes,
			        DimData[Mes],
			        ""
			    )
			
			VAR ReceitaMelhorMes =
			    MAXX(
			        MelhorMes,
			        [@ReceitaMes]
			    )
			
			RETURN
			
			"<div style='width:100%;height:100%;padding:22px 24px;background:#FFFFFF;font-family:Segoe UI,Arial,sans-serif;color:#0F172A;overflow-y:auto;'>
			
			<div style='font-size:18px;font-weight:600;color:#0F172A;'>
			Pontos Positivos
			</div>
			
			<div style='margin-top:5px;font-size:12px;line-height:1.5;color:#64748B;'>
			Indicadores e comportamentos que contribuíram positivamente para o desempenho do período selecionado.
			</div>
			
			<div style='margin-top:70px;'>
			
			<div class='item'>
			<div class='text'>
			<div class='item-title'>Resultado financeiro relevante</div>
			<div class='desc'>
			O período apresenta <strong>" &
			FORMAT(ReceitaAtual,"R$ #,##0.00","pt-BR") &
			"</strong> em receita e <strong>" &
			FORMAT(LucroAtual,"R$ #,##0.00","pt-BR") &
			"</strong> em lucro, demonstrando capacidade consistente de geração de resultado.
			</div>
			</div>
			<span class='badge green'>Financeiro</span>
			</div>
			
			<div class='item'>
			<div class='text'>
			<div class='item-title'>Margem de lucro em destaque</div>
			<div class='desc'>
			A margem atual está em <strong>" &
			FORMAT(MargemAtual,"0.0%","pt-BR") &
			"</strong>, indicador importante da eficiência financeira das vendas realizadas.
			</div>
			</div>
			<span class='badge green'>Margem</span>
			</div>
			
			<div class='item'>
			<div class='text'>
			<div class='item-title'>Melhor momento de faturamento</div>
			<div class='desc'>
			O maior faturamento mensal ocorreu em <strong>" &
			NomeMelhorMes &
			"</strong>, alcançando <strong>" &
			FORMAT(ReceitaMelhorMes,"R$ #,##0.00","pt-BR") &
			"</strong>. Esse comportamento pode indicar um período de maior demanda.
			</div>
			</div>
			<span class='badge blue'>Sazonalidade</span>
			</div>
			
			<div class='item'>
			<div class='text'>
			<div class='item-title'>Produto líder em volume</div>
			<div class='desc'>
			<strong>" &
			NomeTopProduto &
			"</strong> lidera a quantidade de vendas, com <strong>" &
			FORMAT(QtdTopProduto,"#,##0","pt-BR") &
			"</strong> unidades comercializadas no período.
			</div>
			</div>
			<span class='badge blue'>Produto</span>
			</div>
			
			<div class='item'>
			<div class='text'>
			<div class='item-title'>Ticket médio em evolução</div>
			<div class='desc'>
			O ticket médio atual é de <strong>" &
			FORMAT(TicketAtual,"R$ #,##0.00","pt-BR") &
			"</strong>, apresentando variação de <strong>" &
			FORMAT(CrescimentoTicket,"0.0%","pt-BR") &
			"</strong> em relação ao período equivalente anterior.
			</div>
			</div>
			<span class='badge green'>Ticket</span>
			</div>
			
			</div>
			
			<style>
			
			.item{
			display:flex;
			align-items:center;
			justify-content:space-between;
			gap:22px;
			min-height:78px;
			padding:14px 0;
			border-bottom:1px solid #EEF2F6;
			transition:all .18s ease;
			}
			
			.item:first-child{
			border-top:1px solid #EEF2F6;
			}
			
			.item:hover{
			background:#FAFCFB;
			padding-left:10px;
			padding-right:10px;
			border-radius:8px;
			}
			
			.text{
			flex:1;
			min-width:0;
			}
			
			.item-title{
			font-size:15px;
			font-weight:600;
			color:#0F172A;
			margin-bottom:6px;
			}
			
			.desc{
			font-size:13px;
			line-height:1.55;
			color:#64748B;
			}
			
			.desc strong{
			color:#334155;
			font-weight:600;
			}
			
			.badge{
			flex-shrink:0;
			padding:7px 12px;
			border-radius:7px;
			font-size:11px;
			font-weight:600;
			white-space:nowrap;
			}
			
			.green{
			color:#15803D;
			background:#F0FDF4;
			border:1px solid #BBF7D0;
			}
			
			.blue{
			color:#2563EB;
			background:#EFF6FF;
			border:1px solid #BFDBFE;
			}
			
			</style>
			
			</div>"
		displayFolder: HTML Insights
