	measure 'Crescimento Receita Mensal %' =
			
			VAR ReceitaAtual =
			    [Receita Total]
			
			VAR ReceitaMesAnterior =
			    CALCULATE(
			        [Receita Total],
			        DATEADD(DimData[Data], -1, MONTH)
			    )
			
			RETURN
			    DIVIDE(
			        ReceitaAtual - ReceitaMesAnterior,
			        ReceitaMesAnterior
			    )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: KPIS (% Mensal)
		lineageTag: 09f5ed43-e5e3-45be-8b3b-aec7487c4e67

