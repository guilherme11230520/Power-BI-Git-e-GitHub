	measure 'HTML Pontos Positivos Clientes' =
			
			
			VAR ClientesAtual =
			    [Clientes Ativos]
			
			VAR NovosAtual =
			    [Novos Clientes]
			
			VAR RetencaoAtual =
			    [Retencao Clientes]
			
			VAR ClientesAnterior =
			    CALCULATE(
			        [Clientes Ativos],
			        SAMEPERIODLASTYEAR(DimData[Data])
			    )
			
			VAR Crescimento =
			    DIVIDE(
			        ClientesAtual - ClientesAnterior,
			        ClientesAnterior
			    )
			
			VAR TopEstado =
			    TOPN(
			        1,
			        ALLSELECTED(DimCliente[Estado]),
			        CALCULATE([Clientes Ativos]),
			        DESC
			    )
			
			VAR NomeTopEstado =
			    CONCATENATEX(
			        TopEstado,
			        DimCliente[Estado],
			        ""
			    )
			
			VAR QtdTopEstado =
			    MAXX(
			        TopEstado,
			        CALCULATE([Clientes Ativos])
			    )
			
			VAR TopSegmento =
			    TOPN(
			        1,
			        ALLSELECTED(DimCliente[Segmento]),
			        CALCULATE([Clientes Ativos]),
			        DESC
			    )
			
			VAR NomeTopSegmento =
			    CONCATENATEX(
			        TopSegmento,
			        DimCliente[Segmento],
			        ""
			    )
			
			VAR QtdTopSegmento =
			    MAXX(
			        TopSegmento,
			        CALCULATE([Clientes Ativos])
			    )
			
			RETURN
			
			"<div style='width:100%;height:100%;padding:22px 24px;background:#FFFFFF;font-family:Segoe UI,Arial,sans-serif;color:#0F172A;overflow-y:auto;'>
			
			<div style='font-size:18px;font-weight:600;color:#0F172A;'>
			Pontos Positivos
			</div>
			
			<div style='margin-top:5px;font-size:12px;line-height:1.5;color:#64748B;'>
			Resultados que contribuíram positivamente para o desempenho da base de clientes.
			</div>
			
			<div style='margin-top:80px;'>
			
			<div class='item'>
			<div class='text'>
			<div class='item-title'>Base de clientes ativa</div>
			<div class='desc'>
			A base atual conta com <strong>" &
			FORMAT(ClientesAtual,"#,##0","pt-BR") &
			"</strong> clientes ativos no período.
			</div>
			</div>
			<span class='badge green'>Clientes</span>
			</div>
			
			<div class='item'>
			<div class='text'>
			<div class='item-title'>Aquisição de novos clientes</div>
			<div class='desc'>
			Foram conquistados <strong>" &
			FORMAT(NovosAtual,"#,##0","pt-BR") &
			"</strong> novos clientes no período analisado.
			</div>
			</div>
			<span class='badge blue'>Aquisição</span>
			</div>
			
			<div class='item'>
			<div class='text'>
			<div class='item-title'>Estado líder em clientes</div>
			<div class='desc'>
			<strong>" &
			NomeTopEstado &
			"</strong> lidera a base com <strong>" &
			FORMAT(QtdTopEstado,"#,##0","pt-BR") &
			"</strong> clientes ativos.
			</div>
			</div>
			<span class='badge green'>Geografia</span>
			</div>
			
			<div class='item'>
			<div class='text'>
			<div class='item-title'>Segmento com maior presença</div>
			<div class='desc'>
			O segmento <strong>" &
			NomeTopSegmento &
			"</strong> concentra <strong>" &
			FORMAT(QtdTopSegmento,"#,##0","pt-BR") &
			"</strong> clientes ativos.
			</div>
			</div>
			<span class='badge blue'>Segmento</span>
			</div>
			
			</div>
			
			<style>
			
			.item{
			display:flex;
			align-items:center;
			justify-content:space-between;
			gap:22px;
			min-height:78px;
			padding:14px 0;
			border-bottom:1px solid #EEF2F6;
			transition:all .18s ease;
			}
			
			.item:first-child{
			border-top:1px solid #EEF2F6;
			}
			
			.item:hover{
			background:#FAFCFB;
			padding-left:10px;
			padding-right:10px;
			border-radius:8px;
			}
			
			.text{
			flex:1;
			min-width:0;
			}
			
			.item-title{
			font-size:15px;
			font-weight:600;
			color:#0F172A;
			margin-bottom:6px;
			}
			
			.desc{
			font-size:13px;
			line-height:1.55;
			color:#64748B;
			}
			
			.desc strong{
			color:#334155;
			font-weight:600;
			}
			
			.badge{
			flex-shrink:0;
			padding:7px 12px;
			border-radius:7px;
			font-size:11px;
			font-weight:600;
			white-space:nowrap;
			}
			
			.green{
			color:#15803D;
			background:#F0FDF4;
			border:1px solid #BBF7D0;
			}
			
			.blue{
			color:#2563EB;
			background:#EFF6FF;
			border:1px solid #BFDBFE;
			}
			
			</style>
			
			</div>"
		displayFolder: HTML Insights
		lineageTag: 065b36d4-6e63-455d-8335-18dd67c5efaa

	measure 'HTML Pontos de Atenção Clientes' =
			
			
			VAR ClientesAtual =
			    [Clientes Ativos]
			
			VAR ClientesAnterior =
			    CALCULATE(
			        [Clientes Ativos],
			        SAMEPERIODLASTYEAR(DimData[Data])
			    )
			
			VAR Crescimento =
			    DIVIDE(
			        ClientesAtual - ClientesAnterior,
			        ClientesAnterior
			    )
			
			VAR RetencaoAtual =
			    [Retencao Clientes]
			
			VAR NovosAtual =
			    [Novos Clientes]
			
			VAR TopEstado =
			    TOPN(
			        1,
			        ALLSELECTED(DimCliente[Estado]),
			        CALCULATE([Clientes Ativos]),
			        DESC
			    )
			
			VAR NomeTopEstado =
			    CONCATENATEX(
			        TopEstado,
			        DimCliente[Estado],
			        ""
			    )
			
			VAR QtdTopEstado =
			    MAXX(
			        TopEstado,
			        CALCULATE([Clientes Ativos])
			    )
			
			VAR ParticipacaoEstado =
			    DIVIDE(
			        QtdTopEstado,
			        ClientesAtual
			    )
			
			VAR Fundo =
			    "#FFFFFF"
			
			RETURN
			
			"<div style='width:100%;height:100%;padding:22px 24px;background:" &
			Fundo &
			";font-family:Segoe UI,Arial,sans-serif;color:#0F172A;overflow-y:auto;'>
			
			<div style='font-size:18px;font-weight:600;color:#0F172A;'>
			Pontos de Atenção
			</div>
			
			<div style='margin-top:5px;font-size:12px;line-height:1.5;color:#64748B;'>
			Indicadores que merecem acompanhamento para preservar a base de clientes.
			</div>
			
			<div style='margin-top:70px;'>
			
			<div class='item'>
			<div class='text'>
			<div class='item-title'>Evolução da base de clientes</div>
			<div class='desc'>
			A base apresentou uma variação de <strong>" &
			FORMAT(Crescimento,"0.0%","pt-BR") &
			"</strong> em relação ao ano anterior.
			</div>
			</div>
			<span class='badge orange'>Crescimento</span>
			</div>
			
			<div class='item'>
			<div class='text'>
			<div class='item-title'>Retenção exige acompanhamento</div>
			<div class='desc'>
			A retenção atual está em <strong>" &
			FORMAT(RetencaoAtual,"0.0%","pt-BR") &
			"</strong>. Vale acompanhar a recorrência de compra dos clientes.
