	measure 'HTML Pontos de Atenção Executivo' =
			
			
			VAR ReceitaAtual = [Receita Total]
			
			VAR ReceitaAnterior =
			    CALCULATE(
			        [Receita Total],
			        SAMEPERIODLASTYEAR(DimData[Data])
			    )
			
			VAR CrescimentoReceita =
			    DIVIDE(
			        ReceitaAtual - ReceitaAnterior,
			        ReceitaAnterior,
			        0
			    )
			
			VAR QtdAtual = [Qtd Total]
			
			VAR QtdAnterior =
			    CALCULATE(
			        [Qtd Total],
			        SAMEPERIODLASTYEAR(DimData[Data])
			    )
			
			VAR CrescimentoQtd =
			    DIVIDE(
			        QtdAtual - QtdAnterior,
			        QtdAnterior,
			        0
			    )
			
			VAR TicketAtual =
			    DIVIDE(
			        ReceitaAtual,
			        QtdAtual,
			        0
			    )
			
			VAR TicketAnterior =
			    DIVIDE(
			        ReceitaAnterior,
			        QtdAnterior,
			        0
			    )
			
			VAR CrescimentoTicket =
			    DIVIDE(
			        TicketAtual - TicketAnterior,
			        TicketAnterior,
			        0
			    )
			
			VAR LucroAtual = [Lucro Total]
			VAR MargemAtual = [Margem de Lucro %]
			
			VAR ProdutosPrejuizo =
			    FILTER(
			        ALLSELECTED(DimProduto[Produto]),
			        CALCULATE([Lucro Total]) < 0
			    )
			
			VAR QuantidadePrejuizo =
			    COUNTROWS(ProdutosPrejuizo)
			
			VAR PiorProduto =
			    TOPN(
			        1,
			        ALLSELECTED(DimProduto[Produto]),
			        CALCULATE([Lucro Total]),
			        ASC
			    )
			
			VAR NomePiorProduto =
			    CONCATENATEX(
			        PiorProduto,
			        DimProduto[Produto],
			        ""
			    )
			
			VAR LucroPiorProduto =
			    MINX(
			        PiorProduto,
			        CALCULATE([Lucro Total])
			    )
			
			VAR MesesReceita =
			    ADDCOLUMNS(
			        ALLSELECTED(DimData[Mes]),
			        "@ReceitaMes",
			        CALCULATE([Receita Total])
			    )
			
			VAR PiorMes =
			    TOPN(
			        1,
			        MesesReceita,
			        [@ReceitaMes],
			        ASC
			    )
			
			VAR NomePiorMes =
			    CONCATENATEX(
			        PiorMes,
			        DimData[Mes],
			        ""
			    )
			
			VAR ReceitaPiorMes =
			    MINX(
			        PiorMes,
			        [@ReceitaMes]
			    )
			
			RETURN
			
			"<div style='width:100%;height:100%;padding:22px 24px;background:#FFFFFF;font-family:Segoe UI,Arial,sans-serif;color:#0F172A;overflow-y:auto;'>
			
			<div style='font-size:18px;font-weight:600;color:#0F172A;'>
