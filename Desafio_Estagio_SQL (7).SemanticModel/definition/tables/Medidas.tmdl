	measure 'HTML Pontos de Atenção Vendedor' =
			
			
			VAR ReceitaAtual = [Receita Total]
			VAR LucroAtual = [Lucro Total]
			VAR MargemAtual = [Margem de Lucro %]
			VAR QtdAtual = [Qtd Total]
			
			/* =========================
			   PIOR VENDEDOR POR RECEITA
			   ========================= */
			
			VAR PiorVendedorReceita =
			    TOPN(
			        1,
			        ALLSELECTED(DimVendedor[Vendedor]),
			        CALCULATE([Receita Total]),
			        ASC
			    )
			
			VAR NomePiorVendedorReceita =
			    CONCATENATEX(
			        PiorVendedorReceita,
