	measure 'Insight Receita HTML' =
			
			
			VAR UltimaData =
			    CALCULATE(
			        MAX(DimData[Data]),
			        ALLSELECTED(DimData[Data])
			    )
			
			VAR MesAtual =
			    DATE(
			        YEAR(UltimaData),
			        MONTH(UltimaData),
			        1
			    )
			
			VAR MesAnterior =
			    EDATE(MesAtual, -1)
			
			VAR ReceitaAtual =
			    CALCULATE(
			        [Receita Total],
			        REMOVEFILTERS(DimData),
			        DATESBETWEEN(
			            DimData[Data],
			            MesAtual,
			            EOMONTH(MesAtual, 0)
			        )
			    )
			
			VAR ReceitaAnterior =
			    CALCULATE(
			        [Receita Total],
			        REMOVEFILTERS(DimData),
			        DATESBETWEEN(
			            DimData[Data],
			            MesAnterior,
			            EOMONTH(MesAnterior, 0)
			        )
			    )
			
			VAR Variacao =
			    DIVIDE(
			        ReceitaAtual - ReceitaAnterior,
			        ReceitaAnterior,
			        BLANK()
			    )
			
			/* =========================
			   TABELA MENSAL
			   ========================= */
			
			VAR TabelaMensal =
			    ADDCOLUMNS(
			        SUMMARIZE(
			            ALLSELECTED(DimData),
			            DimData[Ano],
			            DimData[Mes],
			            "DataMes",
			                DATE(
			                    DimData[Ano],
			                    DimData[Mes],
			                    1
			                )
			        ),
			        "ReceitaMes",
			            CALCULATE([Receita Total])
			    )
			
			/* =========================
			   MAIOR RECEITA
			   ========================= */
			
			VAR MaiorReceita =
			    MAXX(
			        TabelaMensal,
			        [ReceitaMes]
			    )
			
			VAR MesMaiorReceita =
			    MAXX(
			        FILTER(
			            TabelaMensal,
			            [ReceitaMes] = MaiorReceita
			        ),
			        DimData[Mes]
			    )
			
			/* =========================
			   FORMATAÇÃO
			   ========================= */
			
			VAR ReceitaAtualFormatada =
			    FORMAT(
			        ReceitaAtual,
			        "R$ #,##0.00"
			    )
			
			VAR ReceitaMaiorFormatada =
			    FORMAT(
			        MaiorReceita,
			        "R$ #,##0.00"
			    )
			
			VAR Percentual =
			    FORMAT(
			        ABS(Variacao),
			        "0.00%"
			    )
			
			/* =========================
			   CORES
			   ========================= */
			
			VAR Fundo =
			    SWITCH(
			        TRUE(),
			        Variacao > 0.05, "#EAF7EE",
			        Variacao < -0.05, "#FDECEC",
			        "#F5F5F5"
			    )
			
			VAR Cor =
			    SWITCH(
			        TRUE(),
			        Variacao > 0.05, "#2E7D32",
			        Variacao < -0.05, "#C62828",
			        "#666666"
			    )
			
			VAR Icone =
			    SWITCH(
			        TRUE(),
			        Variacao > 0.05, "✓",
			        Variacao < -0.05, "⚠",
			        "●"
			    )
			
			/* =========================
			   TÍTULO
			   ========================= */
			
			VAR Titulo =
			    SWITCH(
			        TRUE(),
			
			        ISBLANK(Variacao),
			            "Análise da receita",
			
			        Variacao > 0.05,
			            "Desempenho positivo",
			
			        Variacao < -0.05,
			            "Atenção",
			
			        "Receita estável"
			    )
			
			/* =========================
			   MENSAGEM
			   ========================= */
			
			VAR Mensagem =
			    SWITCH(
			        TRUE(),
			
			        ISBLANK(Variacao),
			
			            "Não há dados suficientes para avaliar a evolução da receita no período.",
			
			        Variacao > 0.05,
			
			            "A receita cresceu " &
			            Percentual &
			            " no último mês. " &
			            MesMaiorReceita &
			            " foi o maior destaque do período, com " &
			            ReceitaMaiorFormatada &
			            ", indicando uma evolução favorável no faturamento.",
			
			        Variacao < -0.05,
			
			            "A receita caiu " &
			            Percentual &
			            " no último mês, após alcançar " &
			            ReceitaMaiorFormatada &
			            " em " &
			            MesMaiorReceita &
			            ". O resultado atual de " &
			            ReceitaAtualFormatada &
			            " indica uma desaceleração no fechamento do período.",
			
			        "A receita apresentou pouca variação no último mês, com alteração de " &
			        Percentual &
			        ". O desempenho permanece relativamente estável, sem mudanças relevantes no faturamento."
			    )
			
			RETURN
			
			"<div style='
			    width:100%;
			    height:100%;
			    box-sizing:border-box;
			    background:" & Fundo & ";
			    border-left:4px solid " & Cor & ";
			    border-radius:8px;
			    padding:13px 18px;
			    font-family:Segoe UI;
			'>
			
			    <div style='
			        color:" & Cor & ";
			        font-size:14px;
			        font-weight:700;
			        margin-bottom:5px;
			    '>
			        " & Icone & " " & Titulo & "
			    </div>
			
			    <div style='
			        color:#333333;
			        font-size:12px;
			        line-height:1.45;
			        max-width:100%;
			    '>
			        " & Mensagem & "
			    </div>
			
			</div>"
		displayFolder: HTML Insights
		lineageTag: a6144146-9000-4ba5-b62d-73a3beff6f6b

	measure 'HTML Informações Dashboard' =
			
			
			
			
