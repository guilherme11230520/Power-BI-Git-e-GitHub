			height:11px;
			background:#E5E5E5;
			border-radius:20px;
			overflow:hidden;
			margin-bottom:5px;
			'>
			
			<div style='
			height:100%;
			width:" & FORMAT(PercPF * 100, "0.00") & "%;
			background:" & CorPF & ";
			border-radius:20px;
			'></div>
			
			</div>
			
			<div style='
			font-size:11px;
			color:#858585;
			margin-bottom:16px;
			'>
			" & FORMAT(PF, "#,##0") & " clientes
			</div>
			
			
			<div style='
			display:flex;
			justify-content:space-between;
			align-items:center;
			margin-bottom:7px;
			font-size:14px;
			font-weight:600;
			'>
			
			<span>
			<span style='color:#A3A3A3;'>●</span>
			Pessoa Jurídica
			</span>
			
			<span style='font-size:16px;font-weight:700;'>
			" & FORMAT(PercPJ, "0.00%") & "
			</span>
			
			</div>
			
			<div style='
			width:100%;
			height:11px;
			background:#E5E5E5;
			border-radius:20px;
			overflow:hidden;
			margin-bottom:5px;
			'>
			
			<div style='
			height:100%;
			width:" & FORMAT(PercPJ * 100, "0.00") & "%;
			background:" & CorPJ & ";
			border-radius:20px;
			'></div>
			
			</div>
			
			<div style='
			font-size:11px;
			color:#858585;
			margin-bottom:14px;
			'>
			" & FORMAT(PJ, "#,##0") & " clientes
			</div>
			
			
			<div style='
			height:1px;
			background:#DCDCDC;
			margin-bottom:10px;
			'></div>
			
			
			<div style='
			display:flex;
			justify-content:space-between;
			align-items:center;
			gap:8px;
			'>
			
			<div>
			
			<div style='
			font-size:11px;
			color:#858585;
			margin-bottom:2px;
			'>
			Diferença entre segmentos
			</div>
			
			<div style='
			font-size:24px;
			font-weight:700;
			letter-spacing:-0.5px;
			'>
			" & FORMAT(Diferenca, "0.00%") & "
			</div>
			
			</div>
			
			<div style='
			background:#EEEEEE;
			color:#333333;
			border-radius:20px;
			padding:6px 9px;
			font-size:10px;
			font-weight:600;
			white-space:nowrap;
			'>
			" & SegmentoMaior & " à frente
			</div>
			
			</div>
			
			</div>"
			
			RETURN
			HtmlCode
		displayFolder: HTML Insights
		lineageTag: 4fbc751f-23a0-49d2-bc13-fcaaa9705aef

	measure 'Subtitulo Clientes por Estado' =
			
			VAR BaseEstados =
			    ADDCOLUMNS(
			        ALLSELECTED(DimCliente[Estado]),
			        "__Clientes",
			            CALCULATE([Clientes Ativos])
			    )
			
			VAR Ranking =
			    TOPN(
			        3,
			        BaseEstados,
			        [__Clientes], DESC,
			        DimCliente[Estado], ASC
			    )
			
			VAR Lider =
			    TOPN(
			        1,
			        Ranking,
			        [__Clientes], DESC
			    )
			
			VAR NomeLider =
			    CONCATENATEX(
			        Lider,
			        DimCliente[Estado],
			        ""
			    )
			
			VAR QtdeLider =
			    MAXX(
			        Lider,
			        [__Clientes]
			    )
			
			VAR TotalEstados =
			    CALCULATE(
			        [Clientes Ativos],
			        ALLSELECTED(DimCliente[Estado])
			    )
			
			VAR PercLider =
			    DIVIDE(
			        QtdeLider,
			        TotalEstados,
			        0
			    )
			
			VAR SegundoEstado =
			    TOPN(
			        1,
			        EXCEPT(
			            Ranking,
			            Lider
			        ),
			        [__Clientes], DESC
			    )
			
			VAR NomeSegundo =
			    CONCATENATEX(
			        SegundoEstado,
			        DimCliente[Estado],
			        ""
			    )
			
			VAR QtdeSegundo =
			    MAXX(
			        SegundoEstado,
			        [__Clientes]
			    )
			
			RETURN
			
			"Estado líder: " &
			NomeLider &
			" com " &
			FORMAT(QtdeLider, "#,##0") &
			" clientes ativos • " &
			FORMAT(PercLider, "0.0%") &
			" da base • seguido por " &
			NomeSegundo &
			" com " &
			FORMAT(QtdeSegundo, "#,##0") &
			" clientes"
		displayFolder: Subtítulos
		lineageTag: b0a48b70-6484-4962-aadf-7d03126746c4

	measure 'Insight Clientes HTML 2' =
			
			VAR BaseEstados =
			    ADDCOLUMNS(
			        ALLSELECTED(DimCliente[Estado]),
			        "__Clientes",
			            CALCULATE([Clientes Ativos])
			    )
			
			VAR Top2 =
			    TOPN(
			        2,
			        BaseEstados,
			        [__Clientes], DESC,
			        DimCliente[Estado], ASC
			    )
			
			VAR TotalBase =
			    CALCULATE(
			        [Clientes Ativos],
			        ALLSELECTED(DimCliente[Estado])
			    )
			
			VAR TotalTop2 =
			    SUMX(
			        Top2,
			        [__Clientes]
			    )
			
			VAR PercTop2 =
			    DIVIDE(
			        TotalTop2,
			        TotalBase,
			        0
			    )
			
			RETURN
			
			"<div style='
			    width:100%;
			    height:100%;
			    min-height:10px;
			    box-sizing:border-box;
			    background:#EAF7EE;
			    border-left:4px solid #2E7D32;
			    border-radius:8px;
			    padding:18px 22px;
			    font-family:Segoe UI,Arial,sans-serif;
			    display:flex;
			    flex-direction:column;
			    justify-content:center;
			    overflow:hidden;
			'>
			
			<div style='
			    color:#2E7D32;
			    font-size:16px;
			    font-weight:700;
			    margin-bottom:8px;
			'>
			✓ Concentração geográfica
			</div>
			
			<div style='
			    color:#333333;
			    font-size:14px;
			    line-height:1.55;
			'>
			Os 2 principais estados concentram " &
			FORMAT(PercTop2, "0.0%") &
			" da base de clientes ativos.
			</div>
			
			</div>"
		displayFolder: HTML Insights
		lineageTag: 43bdefb4-e069-4da5-b82c-3f4923699b12

	measure 'HTML Card Clientes Ativos' =
			
			
			VAR Clientes =
			    [Clientes Ativos]
			
			RETURN
			
			"<div class='card'>
			
			    <div class='top'>
			
			        <div class='icon'>
			
			            <svg width='34' height='34'
			                 viewBox='0 0 34 34'
			                 fill='none'
			                 xmlns='http://www.w3.org/2000/svg'>
			
			                <circle cx='17' cy='17' r='16'
			                        stroke='#111111'
			                        stroke-width='2'/>
			
			                <circle cx='17' cy='12' r='4'
			                        stroke='#111111'
			                        stroke-width='2'/>
			
			                <path d='M9 25C9 20 12 18 17 18C22 18 25 20 25 25'
			                      stroke='#111111'
			                      stroke-width='2'
			                      stroke-linecap='round'/>
			
			            </svg>
			
			        </div>
			
			        <div class='arrow'
			             style='color:#111111;'>
			            ↑
			        </div>
			
			    </div>
			
			    <div class='label'>
			        Clientes Ativos
			    </div>
			
			    <div class='value'>
			        " &
			        FORMAT(Clientes, "#,##0", "pt-BR")
			        & "
			    </div>
			
			    <div class='comparison'>
			
			        <span class='comparison-text'>
			            Clientes no período
			        </span>
			
			    </div>
			
			</div>
			
			
			<style>
			
			* {
			    box-sizing: border-box;
			}
			
			.card {
			
			    width: 100%;
			
			    height: 208px;
			
			    padding: 30px 33px 25px 33px;
			
			    background: #FFFFFF;
			
			    border: 1px solid #E2E8F0;
			
			    border-radius: 8px;
			
			    font-family: Segoe UI, Arial, sans-serif;
			
			    position: relative;
			
			    overflow: hidden;
			
			    transition:
			        box-shadow 0.25s ease,
			        transform 0.25s ease,
			        border-color 0.25s ease;
			}
			
			
			/* HOVER DO CARD */
			
			.card:hover {
			
			    box-shadow:
			        0 10px 28px rgba(
			            15,
			            23,
			            42,
			            0.10
			        );
			
			    transform: translateY(-2px);
			
			    border-color: #D7DEE7;
			}
			
			
			/* TOPO */
			
			.top {
			
			    width: 100%;
			
			    display: flex;
			
			    align-items: center;
			
			    justify-content: space-between;
			
			    margin-bottom: 13px;
			}
			
			
