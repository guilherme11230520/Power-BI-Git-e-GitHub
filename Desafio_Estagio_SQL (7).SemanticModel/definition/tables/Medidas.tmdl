	measure 'HTML Pontos Positivos Vendedor' =
			
			
			VAR ReceitaAtual = [Receita Total]
			VAR LucroAtual = [Lucro Total]
			VAR MargemAtual = [Margem de Lucro %]
			VAR QtdAtual = [Qtd Total]
			
			VAR TicketAtual =
			    DIVIDE(
			        ReceitaAtual,
			        QtdAtual,
			        0
			    )
			
			/* =========================
			   TOP VENDEDOR POR RECEITA
			   ========================= */
			
			VAR TopVendedorReceita =
			    TOPN(
			        1,
			        ALLSELECTED(DimVendedor[Vendedor]),
			        CALCULATE([Receita Total]),
			        DESC
			    )
			
			VAR NomeTopVendedorReceita =
			    CONCATENATEX(
			        TopVendedorReceita,
			        DimVendedor[Vendedor],
			        ""
			    )
			
			VAR ReceitaTopVendedor =
			    MAXX(
			        TopVendedorReceita,
			        CALCULATE([Receita Total])
			    )
			
			/* =========================
			   TOP VENDEDOR POR LUCRO
			   ========================= */
			
			VAR TopVendedorLucro =
			    TOPN(
			        1,
			        ALLSELECTED(DimVendedor[Vendedor]),
			        CALCULATE([Lucro Total]),
			        DESC
			    )
			
			VAR NomeTopVendedorLucro =
			    CONCATENATEX(
			        TopVendedorLucro,
			        DimVendedor[Vendedor],
			        ""
			    )
			
			VAR LucroTopVendedor =
			    MAXX(
			        TopVendedorLucro,
			        CALCULATE([Lucro Total])
			    )
			
			/* =========================
			   TOP MARGEM
			   ========================= */
			
			VAR TopVendedorMargem =
			    TOPN(
			        1,
			        ALLSELECTED(DimVendedor[Vendedor]),
			        CALCULATE([Margem de Lucro %]),
			        DESC
			    )
			
			VAR NomeTopVendedorMargem =
			    CONCATENATEX(
			        TopVendedorMargem,
			        DimVendedor[Vendedor],
			        ""
			    )
			
			VAR MargemTopVendedor =
			    MAXX(
			        TopVendedorMargem,
			        CALCULATE([Margem de Lucro %])
			    )
			
			/* =========================
			   MELHOR MÊS
			   ========================= */
			
			VAR MesesReceita =
			    ADDCOLUMNS(
			        ALLSELECTED(DimData[Mes]),
			        "@ReceitaMes",
			        CALCULATE([Receita Total])
			    )
			
			VAR MelhorMes =
			    TOPN(
			        1,
			        MesesReceita,
			        [@ReceitaMes],
			        DESC
			    )
			
			VAR NomeMelhorMes =
			    CONCATENATEX(
			        MelhorMes,
			        DimData[Mes],
			        ""
			    )
			
			VAR ReceitaMelhorMes =
			    MAXX(
			        MelhorMes,
			        [@ReceitaMes]
			    )
			
			RETURN
			
			"<div style='width:100%;height:100%;padding:22px 24px;background:#FFFFFF;font-family:Segoe UI,Arial,sans-serif;color:#0F172A;overflow-y:auto;'>
			
			<div style='font-size:18px;font-weight:600;color:#0F172A;'>
			Pontos Positivos
			</div>
			
			<div style='margin-top:5px;font-size:12px;line-height:1.5;color:#64748B;'>
			Indicadores e comportamentos que contribuíram positivamente para o desempenho dos vendedores no período selecionado.
			</div>
			
			<div style='margin-top:70px;'>
			
			<div class='item'>
			<div class='text'>
			<div class='item-title'>Vendedor líder em faturamento</div>
			<div class='desc'>
			<strong>" &
			NomeTopVendedorReceita &
			"</strong> apresentou a maior receita do período, alcançando <strong>" &
			FORMAT(ReceitaTopVendedor,"R$ #,##0.00","pt-BR") &
			"</strong>. O resultado evidencia sua contribuição para o faturamento da empresa.
			</div>
			</div>
			<span class='badge green'>Receita</span>
			</div>
			
			<div class='item'>
			<div class='text'>
			<div class='item-title'>Maior geração de lucro</div>
			<div class='desc'>
			<strong>" &
			NomeTopVendedorLucro &
			"</strong> liderou em lucro, gerando <strong>" &
			FORMAT(LucroTopVendedor,"R$ #,##0.00","pt-BR") &
			"</strong> no período analisado.
			</div>
			</div>
			<span class='badge green'>Lucro</span>
			</div>
			
			<div class='item'>
			<div class='text'>
			<div class='item-title'>Maior eficiência de margem</div>
			<div class='desc'>
			<strong>" &
			NomeTopVendedorMargem &
			"</strong> apresentou a maior margem de lucro, atingindo <strong>" &
			FORMAT(MargemTopVendedor,"0.0%","pt-BR") &
			"</strong>. Esse comportamento indica maior eficiência na geração de resultado sobre as vendas.
			</div>
			</div>
			<span class='badge green'>Margem</span>
			</div>
			
			<div class='item'>
			<div class='text'>
			<div class='item-title'>Melhor momento de faturamento</div>
			<div class='desc'>
			O maior faturamento mensal ocorreu em <strong>" &
			NomeMelhorMes &
			"</strong>, alcançando <strong>" &
			FORMAT(ReceitaMelhorMes,"R$ #,##0.00","pt-BR") &
			"</strong>. O período pode servir como referência para entender os fatores associados ao melhor desempenho comercial.
			</div>
			</div>
			<span class='badge blue'>Sazonalidade</span>
			</div>
			
			<div class='item'>
			<div class='text'>
			<div class='item-title'>Resultado comercial consistente</div>
			<div class='desc'>
			No período selecionado, a equipe alcançou <strong>" &
