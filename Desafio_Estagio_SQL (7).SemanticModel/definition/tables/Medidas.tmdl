	measure 'HTML Card Lucro' =
			
			
			VAR LucroAtual =
			    [Lucro Total]
			
			VAR Crescimento =
			    [Crescimento Lucro Anual %]
			
			VAR CorCrescimento =
			    IF(
			        Crescimento >= 0,
			        "#16B938",
			        "#DC2626"
			    )
			
			VAR FundoCrescimento =
			    IF(
			        Crescimento >= 0,
			        "#E9FBEF",
			        "#FEF2F2"
			    )
			
			VAR Seta =
			    IF(
			        Crescimento >= 0,
			        "↑",
			        "↓"
			    )
			
			RETURN
			
			"<div class='card'>
			
			    <div class='top'>
			
			        <div class='icon'>
			
			            <svg
			                width='34'
			                height='34'
			                viewBox='0 0 34 34'
			                fill='none'
			                xmlns='http://www.w3.org/2000/svg'>
			
			                <circle
			                    cx='17'
			                    cy='17'
			                    r='16'
			                    stroke='#16B938'
			                    stroke-width='2'/>
			
			                <path
			                    d='M17 8V26'
			                    stroke='#16B938'
			                    stroke-width='2'
			                    stroke-linecap='round'/>
			
			                <path
			                    d='M21 11.5C21 11.5 19.8 9.5 17 9.5C14.3 9.5 12.5 11.1 12.5 13.2C12.5 15.7 14.8 16.4 17 17C19.2 17.6 21.5 18.3 21.5 20.8C21.5 23 19.7 24.5 17 24.5C14.2 24.5 12.8 22.5 12.8 22.5'
			                    stroke='#16B938'
			                    stroke-width='2'
			                    stroke-linecap='round'/>
			
			            </svg>
			
			        </div>
			
			        <div class='arrow'
			             style='color:" & CorCrescimento & ";'>
			
			            " & Seta & "
			
			        </div>
			
			    </div>
			
			
			    <div class='label'>
			        Lucro
			    </div>
			
			
			    <div class='value'>
			
			        " &
			        FORMAT(
			            LucroAtual,
			            "R$ #,##0.00",
			            "pt-BR"
			        )
			        & "
			
			    </div>
			
			
			    <div class='comparison'>
			
			        <span
			            class='percentage'
			            style='
			                color:" & CorCrescimento & ";
			                background:" & FundoCrescimento & ";
			            '>
			
			            " &
			            FORMAT(
			                ABS(Crescimento),
			                "0%",
			                "pt-BR"
			            )
			            & "
			
			        </span>
			
			        <span class='comparison-text'>
			            Vs Ano Anterior
			        </span>
			
			    </div>
			
			</div>
			
			
			<style>
			
			* {
			    box-sizing: border-box;
			}
			
			.card {
			
			    width: 349px;
			
			    height: 208px;
			
			    padding: 30px 33px 25px 33px;
			
			    background: #FFFFFF;
			
			    border: 1px solid #E2E8F0;
			
			    border-radius: 8px;
			
			    font-family: Segoe UI, Arial, sans-serif;
			
			    position: relative;
			
			    overflow: hidden;
			
			    transition:
			        box-shadow 0.25s ease,
			        transform 0.25s ease,
			        border-color 0.25s ease;
			}
			
			
			/* =====================================
			   HOVER
			   ===================================== */
			
			.card:hover {
			
			    box-shadow:
			        0 10px 28px rgba(
			            15,
			            23,
			            42,
			            0.10
			        );
			
			    transform: translateY(-2px);
			
			    border-color: #D7DEE7;
			}
			
			
			/* =====================================
			   TOPO
			   ===================================== */
			
			.top {
			
			    width: 100%;
			
			    display: flex;
			
			    align-items: center;
			
			    justify-content: space-between;
			
			    margin-bottom: 13px;
			}
			
			
			/* =====================================
			   ÍCONE
			   ===================================== */
			
			.icon {
			
			    width: 34px;
			
			    height: 34px;
			
			    display: flex;
			
			    align-items: center;
			
			    justify-content: center;
			}
			
			
			/* =====================================
			   SETA
			   ===================================== */
			
			.arrow {
			
			    font-size: 29px;
			
			    font-weight: 300;
			
			    line-height: 1;
			
			    margin-right: 2px;
			
			    transition:
			        transform 0.25s ease;
			}
			
			.card:hover .arrow {
			
			    transform: translateY(-2px);
			}
			
			
			/* =====================================
			   LABEL
			   ===================================== */
			
			.label {
			
			    font-size: 16px;
			
			    font-weight: 600;
			
			    color: #999999;
			
			    margin-bottom: 8px;
			}
			
			
			/* =====================================
			   VALOR
			   ===================================== */
			
			.value {
			
			    font-size: 27px;
			
			    line-height: 1.1;
			
			    font-weight: 650;
			
			    color: #3F3F3F;
			
			    white-space: nowrap;
			
			    margin-bottom: 10px;
			}
			
			
			/* =====================================
			   COMPARAÇÃO
			   ===================================== */
			
			.comparison {
			
			    display: flex;
			
			    align-items: center;
			
			    gap: 6px;
			}
			
			
			/* =====================================
			   PERCENTUAL YOY
			   ===================================== */
			
			.percentage {
			
			    display: inline-flex;
			
			    align-items: center;
			
			    justify-content: center;
			
			    padding: 4px 10px;
			
			    min-height: 24px;
			
			    border-radius: 12px;
			
			    font-size: 13px;
			
			    font-weight: 650;
			
			    font-variant-numeric: tabular-nums;
			
			    white-space: nowrap;
			
			    transition:
			        transform 0.2s ease,
			        box-shadow 0.2s ease;
			}
			
			
			.card:hover .percentage {
			
			    transform: translateY(-1px);
			
			    box-shadow:
			        0 3px 8px rgba(
			            15,
			            23,
			            42,
			            0.06
			        );
			}
			
			
			/* =====================================
			   TEXTO COMPARATIVO
			   ===================================== */
			
			.comparison-text {
			
			    font-size: 13px;
			
			    font-weight: 500;
			
			    color: #A3A3A3;
			
			    white-space: nowrap;
			}
			
			</style>"
		displayFolder: Cards de HTML
		lineageTag: c357e75c-c278-4c95-9739-d794d9801ce9

	measure 'HTML Card Margem de Lucro' =
			
			
			VAR MargemAtual =
			    [Margem de Lucro %]
			
			VAR Crescimento =
			    [Crescimento Margem de Lucro Anual %]
			
			VAR CorCrescimento =
			    IF(
			        Crescimento >= 0,
			        "#16B938",
			        "#DC2626"
			    )
			
			VAR FundoCrescimento =
			    IF(
			        Crescimento >= 0,
			        "#E9FBEF",
			        "#FEF2F2"
			    )
			
			VAR Seta =
